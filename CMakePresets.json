{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "GE_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "dev",
      "displayName": "Development",
      "inherits": "base"
    },
    {
      "name": "dev-tests",
      "displayName": "Development (tests)",
      "inherits": "dev",
      "cacheVariables": {
        "GE_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base"
    },
    {
      "name": "asan-ubsan",
      "displayName": "AddressSanitizer + UndefinedBehaviorSanitizer",
      "inherits": "dev",
      "cacheVariables": {
        "GAMEENGINE_ENABLE_SANITIZERS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev", "configuration": "Debug" },
    { "name": "dev-tests", "configurePreset": "dev-tests", "configuration": "Debug" },
    { "name": "release", "configurePreset": "release", "configuration": "Release" },
    { "name": "asan-ubsan", "configurePreset": "asan-ubsan", "configuration": "Debug" }
  ],
  "testPresets": [
    {
      "name": "dev-tests",
      "configurePreset": "dev-tests",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "asan-ubsan",
      "configurePreset": "asan-ubsan",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    }
  ]
}
