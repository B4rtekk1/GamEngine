static const uint PBR_DEBUG_FINAL_LIGHTING = 0u;
static const uint PBR_DEBUG_NO_SPECULAR_IBL = 1u;
static const uint PBR_DEBUG_NO_DIRECT_SPECULAR = 2u;
static const uint PBR_DEBUG_NO_GTAO = 3u;
static const uint PBR_DEBUG_GEOMETRIC_DIRECT_DIFFUSE = 4u;

[[vk::binding(1, 0)]] ConstantBuffer<RendererFrameData> frame;
[[vk::binding(5, 0)]] StructuredBuffer<RendererInstanceData> visibleInstances;
[[vk::binding(6, 0)]] StructuredBuffer<uint> visibleInstanceIndices;
#if FORWARD_OUTPUT_VELOCITY
[[vk::binding(8, 0)]] StructuredBuffer<RendererPreviousTransformData> previousTransforms;
#endif
// Dynamic GTAO is deliberately sampled independently of material AO.  It is
// full resolution after a depth-aware upsample and therefore needs no final
// HDR darkening pass.
[[vk::binding(16, 0)]] Sampler2D gtaoVisibility;

struct ForwardVertexInput
{
    [[vk::location(0)]] float3 position : POSITION;
    [[vk::location(1)]] float3 color : COLOR0;
    [[vk::location(2)]] float2 texCoord : TEXCOORD0;
    [[vk::location(4)]] float2 texCoord1 : TEXCOORD1;
    [[vk::location(3)]] float3 normal : NORMAL;
    [[vk::location(8)]] uint materialIndex : MATERIAL_INDEX;
    [[vk::location(9)]] float4 tangent : TANGENT;
};

struct ForwardVertexOutput
{
    float4 position : SV_Position;
    [[vk::location(0)]] float3 color;
    [[vk::location(1)]] float3 worldPosition;
    [[vk::location(2)]] float3 normal;
    [[vk::location(3)]] nointerpolation uint materialIndex;
    [[vk::location(4)]] float2 texCoord;
    [[vk::location(5)]] float4 tangent;
    [[vk::location(6)]] float2 texCoord1;
#if FORWARD_OUTPUT_VELOCITY
    [[vk::location(7)]] noperspective float2 currentNdc;
    [[vk::location(8)]] float4 previousClip;
#endif
};

[shader(\"vertex\")]
ForwardVertexOutput vertexMain(ForwardVertexInput input, uint instanceIndex : SV_InstanceID,
                               uint baseInstance : SV_StartInstanceLocation)
{
    const uint visibleIndex = visibleInstanceIndices[baseInstance + instanceIndex];
    RendererInstanceData instance = visibleInstances[visibleIndex];
    const float3 localPosition = input.position;
    const float3 localNormal = input.normal;

    float4 q = instance.rotation;
    float3x3 rotationMatrix = float3x3(
        1.0 - 2.0 * (q.y * q.y + q.z * q.z), 2.0 * (q.x * q.y + q.z * q.w), 2.0 * (q.x * q.z - q.y * q.w),
        2.0 * (q.x * q.y - q.z * q.w), 1.0 - 2.0 * (q.x * q.x + q.z * q.z), 2.0 * (q.y * q.z + q.x * q.w),
        2.0 * (q.x * q.z + q.y * q.w), 2.0 * (q.y * q.z - q.x * q.w), 1.0 - 2.0 * (q.x * q.x + q.y * q.y));
    float3 worldPosition3 = mul(localPosition * instance.scaleBase.xyz, rotationMatrix) + instance.positionMaterial.xyz;
    float4 worldPosition = float4(worldPosition3, 1.0);
    float3x3 normalMatrix = float3x3(rotationMatrix[0] / instance.scaleBase.x,
                                     rotationMatrix[1] / instance.scaleBase.y,
                                     rotationMatrix[2] / instance.scaleBase.z);

    ForwardVertexOutput output;
    float4 currentClip = mul(mul(worldPosition, frame.view), frame.projection);
#if FORWARD_OUTPUT_VELOCITY
    RendererPreviousTransformData previousTransform = previousTransforms[visibleIndex];
    float4 previousQ = previousTransform.previousRotation;
    float3x3 previousRotationMatrix = float3x3(
        1.0 - 2.0 * (previousQ.y * previousQ.y + previousQ.z * previousQ.z), 2.0 * (previousQ.x * previousQ.y + previousQ.z * previousQ.w), 2.0 * (previousQ.x * previousQ.z - previousQ.y * previousQ.w),
        2.0 * (previousQ.x * previousQ.y - previousQ.z * previousQ.w), 1.0 - 2.0 * (previousQ.x * previousQ.x + previousQ.z * previousQ.z), 2.0 * (previousQ.y * previousQ.z + previousQ.x * previousQ.w),
        2.0 * (previousQ.x * previousQ.z + previousQ.y * previousQ.w), 2.0 * (previousQ.y * previousQ.z - previousQ.x * previousQ.w), 1.0 - 2.0 * (previousQ.x * previousQ.x + previousQ.y * previousQ.y));
    float3 previousWorldPosition = mul(input.position * previousTransform.previousScale.xyz, previousRotationMatrix) +
                                   previousTransform.previousPosition.xyz;
#endif
    output.position = currentClip;
    output.color = input.color;
    output.worldPosition = worldPosition.xyz;
    output.normal = mul(localNormal, normalMatrix);
    output.materialIndex = asuint(instance.positionMaterial.w) + input.materialIndex;
    output.texCoord = input.texCoord;
    output.texCoord1 = input.texCoord1;
    output.tangent = float4(mul(input.tangent.xyz, normalMatrix), input.tangent.w);
#if FORWARD_OUTPUT_VELOCITY
    output.currentNdc = currentClip.xy / currentClip.w;
    output.previousClip = mul(mul(float4(previousWorldPosition, 1.0), frame.previousView), frame.previousProjection);
#endif
    return output;
}

[[vk::binding(0, 0)]] Sampler2DShadow shadowMap;
[[vk::binding(9, 0)]] Sampler2D shadowDepthMap;
[[vk::binding(17, 0)]] Sampler2DShadow linearShadowMap;
[[vk::binding(2, 0)]] StructuredBuffer<MaterialData> materials;
[[vk::binding(10, 0)]] SamplerCube irradianceMap;
[[vk::binding(11, 0)]] SamplerCube prefilteredEnvironmentMap;
[[vk::binding(12, 0)]] Sampler2D brdfIntegrationLut;
[[vk::binding(13, 0)]] Sampler2D materialTextures[];
[[vk::binding(4, 0)]] StructuredBuffer<uint4> shadowPageTable;
[[vk::binding(3, 0)]] StructuredBuffer<ClusterLightRange> clusterRanges;
[[vk::binding(7, 0)]] StructuredBuffer<uint> clusterLightIndices;
// A fixed-capacity table avoids a CPU probe choice per instance. Only
// frame.reflectionProbeCount entries are valid and may be read.
struct ReflectionProbeData
{
    float4 positionAndBlendDistance;
    float4 extentsAndShape;
    uint textureIndex;
    int priority;
    uint flags;
    uint padding;
};
[[vk::binding(14, 0)]] StructuredBuffer<ReflectionProbeData> reflectionProbes;
// Fixed capacity deliberately avoids descriptor indexing/count changes while
// probes are baked. Entry zero is the global prefiltered environment, so an
// unbaked probe is safe to sample immediately.
[[vk::binding(15, 0)]] SamplerCube reflectionProbeTextures[256];

static const uint Probe_Box = 1u << 0u;
static const uint Probe_BoxProject = 1u << 1u;
static const uint Probe_Enabled = 1u << 2u;

float probeInfluence(ReflectionProbeData probe, float3 worldPosition)
{
    if ((probe.flags & Probe_Enabled) == 0u) return 0.0;
    float3 delta = abs(worldPosition - probe.positionAndBlendDistance.xyz);
    float boundary;
    if ((probe.flags & Probe_Box) != 0u)
        boundary = min(min(probe.extentsAndShape.x - delta.x, probe.extentsAndShape.y - delta.y),
                       probe.extentsAndShape.z - delta.z);
    else
        boundary = probe.extentsAndShape.x - length(delta);
    return saturate(boundary / max(probe.positionAndBlendDistance.w, 1e-4));
}

float3 boxProjectedReflection(ReflectionProbeData probe, float3 worldPosition, float3 direction)
{
    if ((probe.flags & (Probe_Box | Probe_BoxProject)) != (Probe_Box | Probe_BoxProject)) return direction;
    float3 local = worldPosition - probe.positionAndBlendDistance.xyz;
    float3 safeDirection = direction + sign(direction) * 1e-5;
    float3 positive = (probe.extentsAndShape.xyz - local) / safeDirection;
    float3 negative = (-probe.extentsAndShape.xyz - local) / safeDirection;
    float3 distances = float3(safeDirection.x > 0.0 ? positive.x : negative.x,
                              safeDirection.y > 0.0 ? positive.y : negative.y,
                              safeDirection.z > 0.0 ? positive.z : negative.z);
    float hitDistance = min(min(distances.x, distances.y), distances.z);
    return normalize(local + direction * max(hitDistance, 0.0));
}

ReflectionCandidate sampleLocalProbes(float3 worldPosition, float3 reflection, float roughness,
                                      uint prefilteredMipCount, ClusterLightRange clusterRange)
{
    if (frame.reflectionProbeCount == 0u)
    {
        ReflectionCandidate none = {float3(0.0), 0.0};
        return none;
    }

    int bestPriority = -2147483647;
    int secondPriority = -2147483647;
    float bestWeight = 0.0;
    float secondWeight = 0.0;
    ReflectionProbeData best;
    ReflectionProbeData second;
    // The compute pass writes probe IDs with its high bit set into the same
    // compact Forward+ list as local lights.  This keeps selection GPU-driven
    // and bounds fragment work by MaxLightsPerCluster, not MaxProbes.
    [loop] for (uint candidate = 0u; candidate < clusterRange.count; ++candidate)
    {
        const uint encodedIndex = clusterLightIndices[clusterRange.offset + candidate];
        if ((encodedIndex & 0x80000000u) == 0u) continue;
        const uint index = encodedIndex & 0x7fffffffu;
        if (index >= frame.reflectionProbeCount) continue;
        ReflectionProbeData probe = reflectionProbes[index];
        float weight = probeInfluence(probe, worldPosition);
        if (weight <= 0.0) continue;
        if (probe.priority > bestPriority || (probe.priority == bestPriority && weight > bestWeight))
        {
            second = best; secondPriority = bestPriority; secondWeight = bestWeight;
            best = probe; bestPriority = probe.priority; bestWeight = weight;
        }
        else if (probe.priority > secondPriority || (probe.priority == secondPriority && weight > secondWeight))
        {
            second = probe; secondPriority = probe.priority; secondWeight = weight;
        }
    }
    float total = bestWeight + secondWeight;
    if (total <= 0.0) { ReflectionCandidate none = {float3(0.0), 0.0}; return none; }
    float mip = roughness * float(max(prefilteredMipCount, 1u) - 1u);
    const uint bestTexture = min(best.textureIndex, 255u);
    float3 value = reflectionProbeTextures[NonUniformResourceIndex(bestTexture)].SampleLevel(
        boxProjectedReflection(best, worldPosition, reflection), mip).rgb * bestWeight;
    if (secondWeight > 0.0)
    {
        const uint secondTexture = min(second.textureIndex, 255u);
        value += reflectionProbeTextures[NonUniformResourceIndex(secondTexture)].SampleLevel(
            boxProjectedReflection(second, worldPosition, reflection), mip).rgb * secondWeight;
    }
    ReflectionCandidate result = {value / total, saturate(total)};
    return result;
}

struct ForwardFragmentInput
{
    float4 position : SV_Position;
    [[vk::location(0)]] float3 color;
    [[vk::location(1)]] float3 worldPosition;
    [[vk::location(2)]] float3 normal;
    [[vk::location(3)]] nointerpolation uint materialIndex;
    [[vk::location(4)]] float2 texCoord;
    [[vk::location(5)]] float4 tangent;
    [[vk::location(6)]] float2 texCoord1;
#if FORWARD_OUTPUT_VELOCITY
    [[vk::location(7)]] noperspective float2 currentNdc;
    [[vk::location(8)]] float4 previousClip;
#endif
    bool isFrontFace : SV_IsFrontFace;
};

struct ForwardFragmentOutput
{
    [[vk::location(0)]] float4 color : SV_Target;
#if FORWARD_OUTPUT_VELOCITY
    [[vk::location(1)]] float2 velocity : SV_Target1;
#endif
};

[shader(\"fragment\")]
ForwardFragmentOutput fragmentMain(ForwardFragmentInput input)
{
    MaterialData material = materials[input.materialIndex];
    float3 vertexColor = input.color;
    if (input.color.r < 0.0)
    {
        float cellCount = max(input.color.g, 1.0);
        int2 cell = int2(clamp(floor(input.texCoord * cellCount),
                              float2(0.0), float2(cellCount - 1.0)));
        float shade = ((cell.x + cell.y) & 1) == 0 ? 0.82 : 0.52;
        vertexColor = shade;
    }

    // Quixel foliage uses COLOR_0 for wind/mask data, not pigment.  Preserve
    // glTF's usual vertex-colour modulation for every other material.
    float3 albedoMultiplier = (material.textureIndices.w & 32) != 0 ? 1.0 : vertexColor;
    float4 baseColor = float4(albedoMultiplier * material.baseColorMetallic.rgb,
                              material.roughnessAmbientOcclusion.w);
    if ((material.textureIndices.w & 8) != 0)
    {
        baseColor = float4(material.baseColorMetallic.rgb, material.roughnessAmbientOcclusion.w);
        float3 weights = saturate(input.color);
        float fourthWeight = saturate(1.0 - weights.x - weights.y - weights.z);
        float4 layers = float4(weights.x, weights.y, weights.z, fourthWeight);
        // Terrain UVs cover the complete heightmap. Repeat each layer so an
        // albedo map reads as ground detail rather than one giant decal.
        // A denser repeat keeps brush-painted material layers at a usable
        // ground-detail scale instead of spreading one oversized texture
        // across a large section of the terrain.
        float2 terrainUv = input.texCoord * 16.0;
        int2 cell = int2(floor(input.texCoord * 32.0));
        float checkerShade = ((cell.x + cell.y) & 1) == 0 ? 0.82 : 0.52;
        float4 checker = float4(checkerShade * material.baseColorMetallic.rgb, 1.0);
        baseColor = 0.0;
        float appliedWeight = 0.0;
        if (material.terrainLayerTextures.x >= 0) { baseColor += materialTextures[NonUniformResourceIndex(material.terrainLayerTextures.x)].Sample(terrainUv) * layers.x; appliedWeight += layers.x; }
        if (material.terrainLayerTextures.y >= 0) { baseColor += materialTextures[NonUniformResourceIndex(material.terrainLayerTextures.y)].Sample(terrainUv) * layers.y; appliedWeight += layers.y; }
        if (material.terrainLayerTextures.z >= 0) { baseColor += materialTextures[NonUniformResourceIndex(material.terrainLayerTextures.z)].Sample(terrainUv) * layers.z; appliedWeight += layers.z; }
        if (material.terrainLayerTextures.w >= 0) { baseColor += materialTextures[NonUniformResourceIndex(material.terrainLayerTextures.w)].Sample(terrainUv) * layers.w; appliedWeight += layers.w; }
        // Blend the unpainted part into the grid instead of leaving it with
        // a zero alpha/colour, which exposed the blue clear colour at edges.
        baseColor = baseColor * float4(material.baseColorMetallic.rgb, 1.0) +
                    checker * (1.0 - saturate(appliedWeight));
        baseColor.a = 1.0;
    }
    else if (material.textureIndices.x >= 0)
        baseColor *= materialTextures[NonUniformResourceIndex(material.textureIndices.x)].Sample(materialTextureUv(material, 0, input.texCoord, input.texCoord1));

    // Cooker may pack this map into base-color alpha; retain the separate
    // path for uncooked glTF/Quixel assets.
    if (material.auxiliaryTextureIndices.y >= 0)
        baseColor.a *= materialTextures[NonUniformResourceIndex(material.auxiliaryTextureIndices.y)].Sample(materialTextureUv(material, 4, input.texCoord, input.texCoord1)).r;

    const bool doubleSided = (material.textureIndices.w & 1) != 0;
    const uint alphaMode = uint((material.textureIndices.w >> 1) & 3);
    // The current two-sided foliage stream is a depth-writing cutout stream.
    // Importers commonly mark vegetation cards as BLEND even though their
    // opacity map is binary. Treat those cards as cutouts until they are
    // routed through a dedicated, sorted transparent stream.
    if (alphaMode == 1)
    {
        if (baseColor.a < material.roughnessAmbientOcclusion.z)
            discard;
        baseColor.a = 1.0;
    }
    else if (alphaMode == 2)
    {
        if (baseColor.a < 0.30)
            discard;
        baseColor.a = 1.0;
    }
    else if (alphaMode == 0) baseColor.a = 1.0;

    float3 albedo = baseColor.rgb;
    float metallic = material.baseColorMetallic.a;
    float roughness = material.roughnessAmbientOcclusion.x;
    if (material.textureIndices.y >= 0)
    {
        float4 metallicRoughness =
            materialTextures[NonUniformResourceIndex(material.textureIndices.y)].Sample(materialTextureUv(material, 1, input.texCoord, input.texCoord1));
        metallic *= metallicRoughness.b;
        roughness *= metallicRoughness.g;
    }
    metallic = clamp(metallic, 0.0, 1.0);
    roughness = clamp(roughness, 0.045, 1.0);

    // Keep the unperturbed, geometric normal.  It is required to prevent a
    // normal map from reflecting the environment through the surface.
    float3 geometricNormal = normalize(input.normal);
    float faceSign = doubleSided && !input.isFrontFace ? -1.0 : 1.0;
    geometricNormal *= faceSign;
    float3 normal = geometricNormal;
    if (material.textureIndices.z >= 0 && abs(material.extensionScalars.x) > 1e-6)
    {
        float3 tangent = normalize(input.tangent.xyz - normal * dot(normal, input.tangent.xyz)) * faceSign;
        float3 bitangent = normalize(cross(normal, tangent)) * input.tangent.w;
        float3 mappedNormal =
            materialTextures[NonUniformResourceIndex(material.textureIndices.z)].Sample(materialTextureUv(material, 2, input.texCoord, input.texCoord1)).xyz * 2.0 - 1.0;
        mappedNormal.xy *= material.extensionScalars.x;
        float3x3 tangentFrame = float3x3(tangent, bitangent, normal);
        normal = normalize(mul(mappedNormal, tangentFrame));
    }

    // This isolates the invariant baseline: no normal map, Fresnel, IBL,
    // specular, AO, shadows or local lights may affect it. It is deliberately
    // evaluated before material-graph normal overrides and specular AA.
    if (frame.pbrDebugView == PBR_DEBUG_GEOMETRIC_DIRECT_DIFFUSE)
    {
        ForwardFragmentOutput diagnosticOutput;
        const float3 diagnosticLightDirection = normalize(-frame.lightDirectionIntensity.xyz);
        diagnosticOutput.color = float4(albedo * max(dot(geometricNormal, diagnosticLightDirection), 0.0), baseColor.a);
#if FORWARD_OUTPUT_VELOCITY
        float2 previousNdc = input.previousClip.xy / input.previousClip.w;
        diagnosticOutput.velocity = (input.currentNdc - previousNdc) * 0.5;
#endif
        return diagnosticOutput;
    }

    float3 viewDirection = normalize(frame.cameraPosition.xyz - input.worldPosition);
#ifdef ENGINE_SHADER_GRAPH
    SurfaceInput graphInput;
    graphInput.worldPosition = input.worldPosition;
    graphInput.worldNormal = normal;
    graphInput.viewDirection = viewDirection;
    graphInput.uv0 = input.texCoord;
    graphInput.uv1 = input.texCoord1;
    graphInput.tangent = normalize(input.tangent.xyz);
    graphInput.bitangent = normalize(cross(normal, graphInput.tangent)) * input.tangent.w;
    graphInput.time = frame.windGustFrequencyTime.w;
    MaterialSurface graphSurface = evaluateMaterial(graphInput);
    baseColor = float4(graphSurface.baseColor, graphSurface.alpha);
    albedo = graphSurface.baseColor;
    metallic = clamp(graphSurface.metallic, 0.0, 1.0);
    roughness = clamp(graphSurface.roughness, 0.045, 1.0);
    normal = normalize(graphSurface.normal);
#endif
    // Specular anti-aliasing: high-frequency normal maps otherwise steer
    // adjacent pixels to unrelated parts of the environment, especially at
    // grazing angles. Derivative-based normal-to-roughness broadens the GGX
    // lobe before both direct-light and IBL BRDF evaluation.
    const float3 normalDx = ddx(normal);
    const float3 normalDy = ddy(normal);
    const float normalVariation = max(length(normalDx), length(normalDy));
    const float aaRoughness = saturate(normalVariation * 0.5);
    roughness = max(roughness, aaRoughness);

    float3 lightDirection = normalize(-frame.lightDirectionIntensity.xyz);
    float3 halfway = normalize(viewDirection + lightDirection);
    float3 dielectricF0 = float3(0.04);
    // KHR_materials_specular: strength is in the alpha channel of
    // specularTexture, while specularColorTexture provides its RGB tint.
    // Do not reinterpret non-glTF/legacy named specular maps as this
    // extension; they have different authoring conventions.
    if ((material.textureIndices.w & 64) != 0)
    {
        float specularStrength = saturate(material.extensionScalars.w);
        float3 specularColor = saturate(material.specularColor.rgb);
        if (material.extensionTextureIndices.y >= 0)
            specularStrength *= materialTextures[NonUniformResourceIndex(material.extensionTextureIndices.y)]
                .Sample(materialTextureUv(material, 8, input.texCoord, input.texCoord1)).a;
        if (material.extensionTextureIndices.z >= 0)
            specularColor *= materialTextures[NonUniformResourceIndex(material.extensionTextureIndices.z)]
                .Sample(materialTextureUv(material, 9, input.texCoord, input.texCoord1)).rgb;
        dielectricF0 *= specularStrength * specularColor;
    }
    float3 f0 = lerp(dielectricF0, albedo, metallic);
    float3 fresnel = fresnelSchlick(max(dot(halfway, viewDirection), 0.0), f0);
    float nDotV = max(dot(normal, viewDirection), 0.0);
    // Thin double-sided cards (leaves, ferns and grass-like glTF meshes) do
    // not have an opaque \"back\".  Their source winding is often arbitrary,
    // so use the incident-light magnitude on either face instead of letting
    // the camera-facing normal make the entire card black.
    float nDotL = doubleSided ? abs(dot(normal, lightDirection))
                              : max(dot(normal, lightDirection), 0.0);
    float geometry = geometrySchlickGGX(nDotV, roughness) *
                     geometrySchlickGGX(nDotL, roughness);
    float3 specular = distributionGGX(normal, halfway, roughness) * geometry * fresnel /
                      max(4.0 * nDotV * nDotL, 0.0001);
    const bool disableDirectSpecular = frame.pbrDebugView == PBR_DEBUG_NO_DIRECT_SPECULAR;
    if (disableDirectSpecular)
        specular = 0.0;
    // The diagnostic removes specular and restores its diffuse energy.  This
    // prevents view-dependent Fresnel from masquerading as a diffuse change.
    float3 diffuse = (1.0 - (disableDirectSpecular ? 0.0 : fresnel)) *
                     (1.0 - metallic) * albedo / PBR_PI;
    ShadowSampleDebug shadowDebug = {0.0, 0.0, 0u, 0u, uint2(0, 0)};
    float shadow = frame.shadowEnabled != 0
        ? sampleVirtualShadow(shadowMap, linearShadowMap, shadowDepthMap, input.worldPosition, normal, lightDirection, frame.shadowClipMatrices,
                              shadowPageTable, frame.shadowQuality, uint2(input.position.xy),
                              frame.temporalSampleIndex, frame.temporalShadowJitter != 0, shadowDebug) : 0.0;
    if (frame.shadowDebugView != SHADOW_DEBUG_OFF)
    {
        ForwardFragmentOutput debugOutput;
        debugOutput.color = float4(shadowDebugColor(frame.shadowDebugView, shadowDebug), baseColor.a);
#if FORWARD_OUTPUT_VELOCITY
        float2 previousNdc = input.previousClip.xy / input.previousClip.w;
        debugOutput.velocity = (input.currentNdc - previousNdc) * 0.5;
#endif
        return debugOutput;
    }
    if (frame.gtaoDebugView != 0u && frame.screenSpaceEffects != 0u)
    {
        ForwardFragmentOutput debugOutput;
        const float visibility = gtaoVisibility.Sample(input.position.xy / frame.clusteredViewportNearFar.xy).r;
        debugOutput.color = float4(visibility.xxx, baseColor.a);
#if FORWARD_OUTPUT_VELOCITY
        float2 previousNdc = input.previousClip.xy / input.previousClip.w;
        debugOutput.velocity = (input.currentNdc - previousNdc) * 0.5;
#endif
        return debugOutput;
    }
    float3 direct = (diffuse + specular) * frame.lightDirectionIntensity.w *
                    frame.lightColor.rgb * nDotL * (1.0 - shadow);
    const uint2 grid = uint2((uint(frame.clusteredViewportNearFar.x) + 63u) / 64u,
                             (uint(frame.clusteredViewportNearFar.y) + 63u) / 64u);
    const float nearPlane = frame.clusteredViewportNearFar.z;
    const float farPlane = frame.clusteredViewportNearFar.w;
    const float viewDepth = max(-mul(float4(input.worldPosition, 1.0), frame.view).z, nearPlane);
    const uint slice = min(uint(log(viewDepth / nearPlane) / log(farPlane / nearPlane) * 24.0), 23u);
    const uint2 tile = min(uint2(input.position.xy) / 64u, grid - 1u);
    const uint clusterIndex = (slice * grid.y + tile.y) * grid.x + tile.x;
    const ClusterLightRange lightRange = clusterRanges[clusterIndex];
    for (uint i = 0u; i < lightRange.count; ++i)
    {
        const uint lightIndex = clusterLightIndices[lightRange.offset + i];
        if ((lightIndex & 0x80000000u) != 0u) continue;
        if (lightIndex >= frame.localLightCount) continue;
        LocalLightData local = frame.localLights[lightIndex];
        float3 toLight = local.positionRange.xyz - input.worldPosition;
        float distanceToLight = length(toLight);
        if (distanceToLight <= 1e-4 || distanceToLight >= local.positionRange.w)
            continue;
        float3 localDirection = toLight / distanceToLight;
        float rangeFactor = saturate(1.0 - distanceToLight / local.positionRange.w);
        float attenuation = rangeFactor * rangeFactor /
                            max(distanceToLight * distanceToLight, 0.01);
        if (local.parameters.y > 1.5) // Spot
        {
            float cone = dot(normalize(-local.directionOuterCos.xyz), localDirection);
            attenuation *= smoothstep(local.directionOuterCos.w, local.parameters.x, cone);
        }
        float localNDotL = doubleSided ? abs(dot(normal, localDirection))
                                       : max(dot(normal, localDirection), 0.0);
        float3 localHalfway = normalize(viewDirection + localDirection);
        float3 localFresnel = fresnelSchlick(max(dot(localHalfway, viewDirection), 0.0), f0);
        float localGeometry = geometrySchlickGGX(nDotV, roughness) *
                              geometrySchlickGGX(localNDotL, roughness);
        float3 localSpecular = distributionGGX(normal, localHalfway, roughness) * localGeometry *
                               localFresnel / max(4.0 * nDotV * localNDotL, 0.0001);
        if (disableDirectSpecular)
            localSpecular = 0.0;
        float3 localDiffuse = (1.0 - (disableDirectSpecular ? 0.0 : localFresnel)) *
                              (1.0 - metallic) * albedo / PBR_PI;
        direct += (localDiffuse + localSpecular) * local.colorIntensity.rgb *
                  local.colorIntensity.w * localNDotL * attenuation;
    }
    float ao = 1.0;
    if (material.auxiliaryTextureIndices.x >= 0)
        ao = lerp(1.0, materialTextures[NonUniformResourceIndex(material.auxiliaryTextureIndices.x)].Sample(materialTextureUv(material, 3, input.texCoord, input.texCoord1)).r,
                  clamp(material.roughnessAmbientOcclusion.y, 0.0, 1.0));
#ifdef ENGINE_SHADER_GRAPH
    ao = graphSurface.ao;
#endif
    float3 emissive = material.emissiveColorIntensity.rgb * material.emissiveColorIntensity.w;
    if (material.extensionTextureIndices.x >= 0)
    {
        emissive *= materialTextures[NonUniformResourceIndex(material.extensionTextureIndices.x)]
            .Sample(materialTextureUv(material, 7, input.texCoord, input.texCoord1)).rgb;
    }
#ifdef ENGINE_SHADER_GRAPH
    emissive = graphSurface.emission;
#endif
    float3 fresnelIbl = fresnelSchlickRoughness(nDotV, f0, roughness);
    const bool disableSpecularIbl = frame.pbrDebugView == PBR_DEBUG_NO_SPECULAR_IBL;
    float3 kS = disableSpecularIbl ? 0.0 : fresnelIbl;
    float3 kD = (1.0 - kS) * (1.0 - metallic);
    float3 diffuseIbl = irradianceMap.Sample(normal).rgb * albedo * kD;
    float3 reflection = reflect(-viewDirection, normal);
    uint prefilteredWidth;
    uint prefilteredHeight;
    uint prefilteredMipCount;
    prefilteredEnvironmentMap.GetDimensions(0, prefilteredWidth, prefilteredHeight, prefilteredMipCount);
    float3 prefiltered = prefilteredEnvironmentMap.SampleLevel(
        reflection, roughness * float(max(prefilteredMipCount, 1u) - 1u)).rgb;
    // The current forward pass provides the global sky.  Local-probe, SSR and
    // RT passes populate the preceding candidates as their resources become
    // available; this explicit resolver keeps the material-side priority
    // fixed as RT -> SSR -> probe -> sky.
    ReflectionCandidate skyReflection = {prefiltered, 1.0};
    ReflectionCandidate localProbeReflection = sampleLocalProbes(input.worldPosition, reflection, roughness,
                                                                  prefilteredMipCount, lightRange);
    ReflectionCandidate screenSpaceReflection = {0.0, 0.0};
    ReflectionCandidate rayTracedReflection = {0.0, 0.0};
    prefiltered = resolveReflection(rayTracedReflection, screenSpaceReflection,
                                    localProbeReflection, skyReflection);
    float2 brdf = brdfIntegrationLut.Sample(float2(nDotV, roughness)).rg;
    float3 specularIbl = prefiltered * (fresnelIbl * brdf.x + brdf.y);
    // Horizon specular occlusion (Filament-style): if normal mapping turns
    // the reflection vector below the geometric surface, no environment
    // radiance is physically visible along that direction.
    const float horizon = saturate(1.0 + dot(reflection, geometricNormal));
    specularIbl *= horizon * horizon;
    if (disableSpecularIbl)
        specularIbl = 0.0;
    // Scene View has an independent render target and no matching GTAO
    // texture yet. Sampling the Game View result there mixes two unrelated
    // screen spaces and produces hard viewport-aligned seams.
    const float dynamicAo = frame.screenSpaceEffects != 0u && frame.pbrDebugView != PBR_DEBUG_NO_GTAO
        ? gtaoVisibility.Sample(input.position.xy /
            float2(frame.clusteredViewportNearFar.x, frame.clusteredViewportNearFar.y)).r
        : 1.0;
    // Material and screen-space visibility both describe indirect-light
    // accessibility, so neither is allowed to brighten the other.  The
    // GTAO visibility is used at full strength after its bilateral upsample.
    const float indirectVisibility = min(ao, dynamicAo);
    const float diffuseAO = indirectVisibility;
    // Lagarde's visibility-based specular-occlusion approximation.  It
    // suppresses sky/probe reflections in contact cavities without needing a
    // bent normal; rough surfaces converge to the diffuse visibility while
    // smooth ones retain the expected view-angle dependence.
    const float specularOcclusion = saturate(
        pow(saturate(nDotV) + indirectVisibility,
            exp2(-16.0 * roughness - 1.0)) - 1.0 + indirectVisibility);
    float3 ambient = diffuseIbl * diffuseAO + specularIbl * specularOcclusion;
    float3 color = ambient + direct + emissive;
#if MATERIAL_VARIANT == 1
    // Unlit keeps texture/base-color authoring but deliberately skips scene lighting.
    color = albedo + emissive;
#elif MATERIAL_VARIANT == 2
    // Hologram is emissive, view-dependent and uses world-space scan lines.
    float scanline = 0.55 + 0.45 * sin(input.worldPosition.y * 90.0 + frame.windGustFrequencyTime.w * 8.0);
    float hologramFresnel = pow(1.0 - saturate(dot(normal, viewDirection)), 3.0);
    color = albedo * (0.25 + scanline * 0.75) + emissive + float3(0.05, 0.65, 1.0) * hologramFresnel;
#endif
    // Foliage has a cheap, stable back-lighting term.  The flag is deliberately
    // material data rather than an asset-name heuristic at runtime.
    if ((material.textureIndices.w & 16) != 0 && material.auxiliaryTextureIndices.z >= 0) {
        float mask = materialTextures[NonUniformResourceIndex(material.auxiliaryTextureIndices.z)].Sample(materialTextureUv(material, 5, input.texCoord, input.texCoord1)).r;
        float backLight = saturate(dot(-normal, lightDirection));
        color += albedo * frame.lightColor.rgb * frame.lightDirectionIntensity.w *
                 backLight * mask * material.extensionScalars.y;
    }

    ForwardFragmentOutput output;
    output.color = float4(color, baseColor.a);
#if FORWARD_OUTPUT_VELOCITY
    float2 previousNdc = input.previousClip.xy / input.previousClip.w;
    output.velocity = (input.currentNdc - previousNdc) * 0.5;
#endif
    return output;
}
"
         %32 = OpString "C:\\Users\\Bartosz Kasyna\\CLionProjects\\GamEngine\\Engine\\Shaders\\Forward\\forward_pbr.slang"
         %34 = OpString "struct LocalLightData
{
    float4 positionRange;
    float4 directionOuterCos;
    float4 colorIntensity;
    float4 parameters;
};

struct ClusterLightRange
{
    uint offset;
    uint count;
};

struct RendererFrameData
{
    float4x4 view;
    float4x4 projection;
    float4x4 inverseProjection;
    float4x4 inverseView;
    float4x4 previousView;
    float4x4 previousProjection;
    float4x4 shadowClipMatrices[7];
    float4 cameraPosition;
    float4 lightDirectionIntensity;
    float4 lightColor;
    float4 windDirectionStrength;
    float4 windSourcePositionRange;
    float4 windGustFrequencyTime;
    uint shadowEnabled;
    uint shadowQuality;
    uint shadowDebugView;
    uint gtaoDebugView;
    uint materialSlots;
    uint selectedInstance;
    uint localLightCount;
    // Number of valid records in the reflection-probe SSBO.  The buffer has
    // fixed storage capacity, but entries beyond this count are not populated.
    uint reflectionProbeCount;
    // Zero for views without matching full-screen inputs (currently Scene
    // View); prevents sampling Game View's GTAO/depth/colour textures.
    uint screenSpaceEffects;
    uint temporalShadowJitter;
    uint temporalSampleIndex;
    // PbrDebugView: 0=final, 1=no specular IBL, 2=no direct specular,
    // 3=no GTAO, 4=geometric-normal direct diffuse. Kept in the former
    // padding slot to preserve UBO layout.
    uint pbrDebugView;
    // xy viewport pixels, z near plane, w far plane.
    float4 clusteredViewportNearFar;
    LocalLightData localLights[32];
};

struct MaterialData
{
    float4 baseColorMetallic;
    float4 roughnessAmbientOcclusion;
    int4 textureIndices;
    int4 terrainLayerTextures;
    int4 auxiliaryTextureIndices;
    float4 extensionScalars;
    int4 extensionTextureIndices;
    float4 specularColor;
    float4 emissiveColorIntensity;
    int4 textureCoordinateSets0;
    int4 textureCoordinateSets1;
    int4 textureCoordinateSets2;
    float4 textureTransforms[10];
    float4 textureTransformRotations[3];
    float4 waterShallowColorRoughness;
    float4 waterDeepColorIor;
    float4 waterAbsorptionRefraction;
    float4 waterScatteringMaxDepth;
    // x foam intensity, y threshold, z normal strength, w feature flags.
    float4 waterFoam;
    // normal map, foam map, flow map, reserved.
    int4 waterTextureIndices;
    float4 waterWaves[8];
    float4 waterWaveMotion[8];
    uint4 waterWaveCount;
};

float2 materialTextureUv(MaterialData material, uint slot, float2 uv0, float2 uv1)
{
    int texCoord = slot < 4 ? material.textureCoordinateSets0[slot] :
                   slot < 8 ? material.textureCoordinateSets1[slot - 4] :
                              material.textureCoordinateSets2[slot - 8];
    float2 uv = texCoord == 1 ? uv1 : uv0;
    float4 transform = material.textureTransforms[slot];
    float sine; float cosine;
    sincos(material.textureTransformRotations[slot / 4][slot % 4], sine, cosine);
    float2 scaled = uv * transform.zw;
    float2 rotated = float2(cosine * scaled.x - sine * scaled.y,
                            sine * scaled.x + cosine * scaled.y);
    return rotated + transform.xy;
}

// Mirrors Engine::RendererInstanceData and RendererPreviousTransformData.
// The renderer binds these tables as SSBOs so instance fetch is driven by the
// indirect command's firstInstance, not a vertex-input binding.
struct RendererInstanceData
{
    float4 positionMaterial;
    float4 rotation;
    float4 scaleBase;
};

struct RendererPreviousTransformData
{
    float4 previousPosition;
    float4 previousRotation;
    float4 previousScale;
};
"
         %36 = OpString "C:/Users/Bartosz Kasyna/CLionProjects/GamEngine/Engine/Shaders/Common/SceneData.slang"
         %37 = OpString "static const float PBR_PI = 3.14159265359;

float distributionGGX(float3 normal, float3 halfway, float roughness)
{
    float a2 = roughness * roughness * roughness * roughness;
    float nDotH2 = max(dot(normal, halfway), 0.0);
    nDotH2 *= nDotH2;
    float denominator = nDotH2 * (a2 - 1.0) + 1.0;
    return a2 / max(PBR_PI * denominator * denominator, 0.0001);
}

float geometrySchlickGGX(float nDotV, float roughness)
{
    float k = (roughness + 1.0) * (roughness + 1.0) / 8.0;
    return nDotV / max(nDotV * (1.0 - k) + k, 0.0001);
}

float geometrySmith(float3 normal, float3 viewDirection,
                    float3 lightDirection, float roughness)
{
    return geometrySchlickGGX(max(dot(normal, viewDirection), 0.0), roughness) *
           geometrySchlickGGX(max(dot(normal, lightDirection), 0.0), roughness);
}

float3 fresnelSchlick(float cosTheta, float3 f0)
{
    return f0 + (1.0 - f0) * pow(1.0 - cosTheta, 5.0);
}

float3 fresnelSchlickRoughness(float cosTheta, float3 f0, float roughness)
{
    return f0 + (max(float3(1.0 - roughness), f0) - f0) * pow(1.0 - cosTheta, 5.0);
}
"
         %39 = OpString "C:/Users/Bartosz Kasyna/CLionProjects/GamEngine/Engine/Shaders/Common/PbrLighting.slang"
         %40 = OpString "import Common.ShadowLod;

// This is only a numerical floor.  The actual receiver bias is calculated
// from the shadow texel footprint below; a fixed 0.0002 depth offset was large
// enough to hide the slope term on nearly every receiver.
static const float MIN_SHADOW_BIAS = 1.0e-5;
static const float LEGACY_MIN_SHADOW_BIAS = 0.0002;
static const float LEGACY_SLOPE_SHADOW_BIAS = 0.003;
static const float SHADOW_TEXEL_BIAS_SCALE = 2.0;
static const float GEOMETRIC_NORMAL_OFFSET_TEXELS = 0.1;
static const uint SHADOW_CLIP_LEVELS = 7;
static const uint PHYSICAL_PAGES_PER_AXIS = 16;
static const uint INVALID_SHADOW_PAGE = 0xffffffff;
static const uint SHADOW_DEBUG_OFF = 0;
static const uint SHADOW_DEBUG_BLOCKER_COUNT = 1;
static const uint SHADOW_DEBUG_PENUMBRA_RADIUS = 2;
static const uint SHADOW_DEBUG_DESIRED_CLIP_LEVEL = 3;
static const uint SHADOW_DEBUG_RESOLVED_CLIP_LEVEL = 4;
static const uint SHADOW_DEBUG_FALLBACK_DELTA = 5;
static const uint SHADOW_DEBUG_VIRTUAL_PAGE = 6;

struct ShadowSampleDebug
{
    float blockerCount;
    float penumbraRadius;
    uint desiredClipLevel;
    uint resolvedClipLevel;
    uint2 virtualPage;
};

// Resolving the page once is enough for every texel of a bilinear footprint
// that stays inside that page. This is the common case (only a two-texel-wide
// strip around each page edge needs the general resolver below), and avoids
// three redundant page-table fetches per logical PCF tap.
bool resolveVirtualShadowPage(uint2 page, uint level,
                              StructuredBuffer<uint4> pageTable, out uint physical)
{
    physical = INVALID_SHADOW_PAGE;
    if (any(page >= uint2(VIRTUAL_PAGES_PER_AXIS)))
        return false;
    const uint tableIndex = level * VIRTUAL_PAGES_PER_AXIS * VIRTUAL_PAGES_PER_AXIS +
                            page.y * VIRTUAL_PAGES_PER_AXIS + page.x;
    physical = pageTable[tableIndex >> 2][tableIndex & 3];
    return physical != INVALID_SHADOW_PAGE;
}

float2 virtualTexelAtlasUv(uint2 texel, uint physical)
{
    const uint2 physicalPage = uint2(physical % PHYSICAL_PAGES_PER_AXIS,
                                     physical / PHYSICAL_PAGES_PER_AXIS);
    const uint2 localPixel = texel % PAGE_RESOLUTION;
    return (float2(physicalPage * PAGE_RESOLUTION + localPixel) + 0.5) /
           float(PHYSICAL_PAGES_PER_AXIS * PAGE_RESOLUTION);
}

// Unlike virtualTexelAtlasUv(), this retains the fractional virtual-pixel
// position. It is valid for hardware bilinear PCF only after the caller has
// established that its complete 2x2 footprint is inside this physical page.
float2 virtualPixelAtlasUv(float2 virtualPixel, uint physical)
{
    const uint2 physicalPage = uint2(physical % PHYSICAL_PAGES_PER_AXIS,
                                     physical / PHYSICAL_PAGES_PER_AXIS);
    const float2 localPixel = virtualPixel - floor(virtualPixel / PAGE_RESOLUTION) * PAGE_RESOLUTION;
    return (float2(physicalPage * PAGE_RESOLUTION) + localPixel) /
           float(PHYSICAL_PAGES_PER_AXIS * PAGE_RESOLUTION);
}

// Resolves one virtual texel to the centre of its physical atlas texel.
bool resolveVirtualShadowTexel(int2 texel, uint level,
                               StructuredBuffer<uint4> pageTable, out float2 atlasUv)
{
    atlasUv = 0.0;
    if (any(texel < int2(0)) || any(texel >= int2(VIRTUAL_RESOLUTION)))
        return false;
    uint2 pixel = uint2(texel);
    uint physical;
    if (!resolveVirtualShadowPage(pixel / PAGE_RESOLUTION, level, pageTable, physical))
        return false;
    atlasUv = virtualTexelAtlasUv(pixel, physical);
    return true;
}

bool virtualShadowAtlasUv(float2 virtualPixel, uint level,
                          StructuredBuffer<uint4> pageTable, out float2 atlasUv)
{
    return resolveVirtualShadowTexel(int2(floor(virtualPixel)), level, pageTable, atlasUv);
}

// The atlas sampler is intentionally nearest-filtered: filtering it directly
// would blend unrelated physical pages.  Reconstruct a bilinear sample in
// *virtual* texel space instead, resolving each of the four texels separately.
// A missing neighbour is omitted and the remaining weights are normalized.  A
// resident centre texel therefore remains usable at a cache boundary rather
// than forcing an abrupt clipmap fallback.
float sampleVirtualShadowBilinear(Sampler2DShadow shadowMap, Sampler2DShadow linearShadowMap,
                                  float2 virtualPixel,
                                  uint level, StructuredBuffer<uint4> pageTable,
                                  float compareDepth, out bool hasSamples)
{
    const float2 texelSpace = virtualPixel - 0.5;
    const int2 base = int2(floor(texelSpace));
    const float2 fraction = frac(texelSpace);
    const float weights[4] = {
        (1.0 - fraction.x) * (1.0 - fraction.y),
        fraction.x * (1.0 - fraction.y),
        (1.0 - fraction.x) * fraction.y,
        fraction.x * fraction.y};
    const int2 offsets[4] = {int2(0, 0), int2(1, 0), int2(0, 1), int2(1, 1)};

    // Fast path: the entire bilinear footprint is resident in one virtual
    // page. Its physical 2x2 footprint is therefore contiguous too, so one
    // hardware linear comparison exactly replaces four resolved comparisons.
    const bool footprintInPage = (base.x % int(PAGE_RESOLUTION)) != int(PAGE_RESOLUTION - 1) &&
                                 (base.y % int(PAGE_RESOLUTION)) != int(PAGE_RESOLUTION - 1);
    if (all(base >= int2(0)) && all(base + int2(1) < int2(VIRTUAL_RESOLUTION)) && footprintInPage)
    {
        uint physical;
        if (resolveVirtualShadowPage(uint2(base) / PAGE_RESOLUTION, level, pageTable, physical))
        {
            hasSamples = true;
            return 1.0 - linearShadowMap.SampleCmpLevelZero(
                virtualPixelAtlasUv(virtualPixel, physical), compareDepth);
        }
    }

    float shadow = 0.0;
    float totalWeight = 0.0;
    [unroll]
    for (uint tap = 0; tap < 4; ++tap)
    {
        float2 atlasUv;
        if (!resolveVirtualShadowTexel(base + offsets[tap], level, pageTable, atlasUv))
            continue;
        shadow += (1.0 - shadowMap.SampleCmpLevelZero(atlasUv, compareDepth)) * weights[tap];
        totalWeight += weights[tap];
    }
    hasSamples = totalWeight > 0.0;
    return hasSamples ? shadow / totalWeight : 0.0;
}

// Read one unfiltered virtual texel for the PCSS blocker pass. Sampling the
// physical atlas directly is safe only after this virtual-to-physical resolve.
bool sampleVirtualShadowDepth(Sampler2D shadowDepthMap, float2 virtualPixel,
                              uint level, StructuredBuffer<uint4> pageTable,
                              out float depth)
{
    float2 atlasUv;
    if (!virtualShadowAtlasUv(virtualPixel, level, pageTable, atlasUv))
    {
        depth = 1.0;
        return false;
    }
    depth = shadowDepthMap.SampleLevel(atlasUv, 0.0).x;
    return true;
}

float shadowWorldTexelSize(float4x4 lightSpace)
{
    // Orthographic clip matrices scale the light-space X/Y axes by 1/extent.
    // Reading that scale keeps the receiver bias correct for the dynamic far
    // clipmap as well as the fixed near levels.
    // Positions are transformed as row vectors below, so each clip-space
    // component is formed from a *column* of the matrix, not a row.
    const float3 clipXGradient = float3(lightSpace[0][0], lightSpace[1][0], lightSpace[2][0]);
    const float3 clipYGradient = float3(lightSpace[0][1], lightSpace[1][1], lightSpace[2][1]);
    const float lightSpaceScale = max(max(length(clipXGradient), length(clipYGradient)), 1.0e-6);
    return 2.0 / (float(VIRTUAL_RESOLUTION) * lightSpaceScale);
}

float shadowLightDepthScale(float4x4 lightSpace)
{
    const float3 clipZGradient = float3(lightSpace[0][2], lightSpace[1][2], lightSpace[2][2]);
    return max(length(clipZGradient), 1.0e-6);
}

float shadowReceiverDepthBias(float currentDepth, float2 uv, float4x4 lightSpace)
{
    // A receiver plane may cross several shadow texels per screen pixel, or
    // only a fraction of one.  Convert the screen-space depth derivatives to
    // depth per virtual-shadow texel, then cover the 2-texel comparison
    // footprint.  This prevents quantized shadow depths from producing acne
    // bands on large, nearly planar receivers.
    const float2 uvDx = ddx(uv);
    const float2 uvDy = ddy(uv);
    const float zDx = ddx(currentDepth);
    const float zDy = ddy(currentDepth);
    const float determinant = uvDx.x * uvDy.y - uvDx.y * uvDy.x;
    const float texelDepth = shadowWorldTexelSize(lightSpace) *
                             shadowLightDepthScale(lightSpace);
    const float maxReceiverBias = texelDepth * 3.0;
    // Invert the screen-to-shadow-UV Jacobian.  Taking independent maxima of
    // depth and UV derivatives can pair values from different screen axes and
    // severely underestimate the required bias on diagonally projected planes.
    float receiverPlaneBias = 0.0;
    if (abs(determinant) > 1.0e-8)
    {
        const float dzdu = (uvDy.y * zDx - uvDx.y * zDy) / determinant;
        const float dzdv = (uvDx.x * zDy - uvDy.x * zDx) / determinant;
        const float calculatedBias = SHADOW_TEXEL_BIAS_SCALE *
                                     (abs(dzdu) + abs(dzdv)) /
                                     float(VIRTUAL_RESOLUTION);
        // A nearly singular Jacobian can turn tiny derivative noise into an
        // arbitrarily large depth offset. Never let receiver-plane bias move
        // the comparison by more than a few shadow texels.
        receiverPlaneBias = min(calculatedBias, maxReceiverBias);
    }

    // The geometric normal offset is applied in world space by the caller.
    // Keep comparison bias responsible only for receiver-plane quantization
    // and slope acne; do not add a second angle-dependent normal offset here.
    return max(MIN_SHADOW_BIAS, receiverPlaneBias);
}

float shadowKernelRotation(uint2 pixelCoordinate, uint temporalSampleIndex,
                           bool temporalShadowJitter)
{
    uint hash = pixelCoordinate.x * 1664525u + pixelCoordinate.y * 1013904223u;
    if (temporalShadowJitter)
        hash ^= temporalSampleIndex * 747796405u;
    hash = (hash ^ (hash >> 16u)) * 2246822519u;
    hash ^= hash >> 13u;
    return float(hash & 0x00ffffffu) / float(0x01000000u) * 6.28318530718;
}

float sampleVirtualShadowLevel(Sampler2DShadow shadowMap, Sampler2DShadow linearShadowMap,
                               Sampler2D shadowDepthMap,
                               float3 worldPosition,
                               float3 normal, float3 lightDirection,
                               float4x4 lightSpace, uint level,
                               StructuredBuffer<uint4> pageTable, uint shadowQuality,
                               uint2 pixelCoordinate, uint temporalSampleIndex,
                               bool temporalShadowJitter, out bool resident,
                               out float clipEdge, out float blockerCount,
                               out float penumbraRadius, out uint2 virtualPage)
{
    blockerCount = 0.0;
    penumbraRadius = 0.0;
    virtualPage = 0;
    // A small geometric separation prevents self-intersection. The receiver
    // comparison bias below handles slope/quantization independently.
    const float normalBias = shadowWorldTexelSize(lightSpace) *
                             GEOMETRIC_NORMAL_OFFSET_TEXELS;
    const float3 shadowPosition = worldPosition + normalize(normal) * normalBias;
    float4 lightSpacePosition = mul(float4(shadowPosition, 1.0), lightSpace);
    float3 projected = lightSpacePosition.xyz / lightSpacePosition.w;
    float2 uv = projected.xy * 0.5 + 0.5;
    float currentDepth = projected.z;
    clipEdge = max(abs(projected.x), abs(projected.y));
    float2 centerAtlasUv = 0.0;
    resident = currentDepth > 0.0 && currentDepth < 1.0 &&
               virtualShadowAtlasUv(uv * VIRTUAL_RESOLUTION, level,
                                    pageTable, centerAtlasUv);
    if (!resident)
        return 0.0;

    const float2 virtualPixel = uv * float(VIRTUAL_RESOLUTION);
    virtualPage = uint2(virtualPixel) / PAGE_RESOLUTION;

    const float bias = shadowReceiverDepthBias(currentDepth, uv, lightSpace);
    // Keep a single comparison exclusively for the deliberately lowest
    // settings.  A single coarse-clipmap texel spans centimetres in world
    // space, so using it at High creates visible stair-steps after a page
    // fallback.
    const bool useSingleTap = shadowQuality == SHADOW_QUALITY_LOW ||
                              (shadowQuality == SHADOW_QUALITY_MEDIUM && level >= 2);
    if (useSingleTap)
        return 1.0 - shadowMap.SampleCmpLevelZero(centerAtlasUv, currentDepth - bias);

    // The physical atlas deliberately has a nearest sampler: adjacent tiles
    // can represent unrelated virtual pages. Every filtered tap must therefore
    // resolve its own virtual texel before sampling the atlas.
    const bool useStablePoisson = shadowQuality == SHADOW_QUALITY_ULTRA;
    // The edge-only PCF16 is also useful on coarse levels, where the virtual
    // grid is otherwise most visible.
    const bool useHighEdgeFilter = shadowQuality == SHADOW_QUALITY_HIGH;

    static const float2 poisson[16] = {
        float2(-0.94201624, -0.39906216), float2(0.94558609, -0.76890725),
        float2(-0.09418410, -0.92938870), float2(0.34495938, 0.29387760),
        float2(-0.91588581, 0.45771432), float2(-0.81544232, -0.87912464),
        float2(-0.38277543, 0.27676845), float2(0.97484398, 0.75648379),
        float2(0.44323325, -0.97511554), float2(0.53742981, -0.47373420),
        float2(-0.26496911, -0.41893023), float2(0.79197514, 0.19090188),
        float2(-0.24188840, 0.99706507), float2(-0.81409955, 0.91437590),
        float2(0.19984126, 0.78641367), float2(0.14383161, -0.14100790)};
    const float rotation = shadowKernelRotation(pixelCoordinate, temporalSampleIndex,
                                                temporalShadowJitter);
    float rotationSin;
    float rotationCos;
    sincos(rotation, rotationSin, rotationCos);

    if (useStablePoisson)
    {
        // PCSS needs a receiver-dependent search region too: a finite light
        // subtends a larger cone at receivers farther along the light axis.
        // The first four samples cover the centre. If all four are blockers,
        // the receiver is inside a stable solid shadow and the outer ring is
        // skipped; silhouette and foliage pixels receive all eight samples.
        const float lightDepthScale = shadowLightDepthScale(lightSpace);
        const float sunAngularRadius = 0.00465;
        const float blockerSearchRadius = clamp(
            tan(sunAngularRadius) * max(currentDepth, 0.02) /
            (lightDepthScale * shadowWorldTexelSize(lightSpace)), 0.75, 4.0);
        static const float2 blockerOffsets[8] = {
            float2(0.0, 0.0), float2(-0.45, -0.35),
            float2(0.45, -0.35), float2(0.0, 0.48),
            float2(-0.92, -0.62), float2(0.88, -0.58),
            float2(-0.67, 0.82), float2(0.72, 0.76)};
        float blockerDepthSum = 0.0;
        [unroll]
        for (uint blockerTap = 0; blockerTap < 4; ++blockerTap)
        {
            float blockerDepth;
            if (sampleVirtualShadowDepth(shadowDepthMap,
                                         virtualPixel + blockerOffsets[blockerTap] * blockerSearchRadius,
                                         level, pageTable, blockerDepth) &&
                blockerDepth < currentDepth - bias)
            {
                blockerDepthSum += blockerDepth;
                blockerCount += 1.0;
            }
        }
        if (blockerCount < 4.0)
        {
            [unroll]
            for (uint blockerTap = 4; blockerTap < 8; ++blockerTap)
            {
                float blockerDepth;
                if (sampleVirtualShadowDepth(shadowDepthMap,
                                             virtualPixel + blockerOffsets[blockerTap] * blockerSearchRadius,
                                             level, pageTable, blockerDepth) &&
                    blockerDepth < currentDepth - bias)
                {
                    blockerDepthSum += blockerDepth;
                    blockerCount += 1.0;
                }
            }
        }
        if (blockerCount == 0.0)
            return 0.0;

        // Convert the receiver/blocker separation from projected depth to a
        // world-space distance, then to virtual texels.  0.00465 rad is the
        // Sun's angular radius; clamping prevents a distant occluder from
        // turning a page miss or a thin object into an impractically broad
        // filter.  This is intentionally a PCSS approximation, not SMRT.
        const float averageBlockerDepth = blockerDepthSum / blockerCount;
        const float receiverBlockerDistance =
            max(currentDepth - averageBlockerDepth, 0.0) / lightDepthScale;
        penumbraRadius = clamp(
            tan(sunAngularRadius) * receiverBlockerDistance /
            shadowWorldTexelSize(lightSpace), 0.25, 6.0);

        // Contact shadows need silhouette antialiasing too; penumbra width
        // must not reduce the comparison budget below twelve samples.
        const uint tapCount = penumbraRadius < 3.5 ? 12u : 16u;
        float filteredShadow = 0.0;
        float totalWeight = 0.0;
        [loop]
        for (uint tap = 0; tap < tapCount; ++tap)
        {
            bool tapResident;
            const float2 offset = float2(
                poisson[tap].x * rotationCos - poisson[tap].y * rotationSin,
                poisson[tap].x * rotationSin + poisson[tap].y * rotationCos);
            const float tapShadow = sampleVirtualShadowBilinear(
                shadowMap, linearShadowMap, virtualPixel + offset * penumbraRadius, level, pageTable,
                currentDepth - bias, tapResident);
            if (!tapResident)
                continue;
            filteredShadow += tapShadow;
            totalWeight += 1.0;
        }
        return totalWeight > 0.0 ? filteredShadow / totalWeight : 0.0;
    }

    // Medium remains deliberately inexpensive. Centre its four continuous
    // bilinear samples on the receiver; using offsets 0..1 shifted the whole
    // filter half a virtual texel towards +X/+Y.
    if (!useHighEdgeFilter)
    {
        float filteredShadow = 0.0;
        float totalWeight = 0.0;
        [unroll]
        for (int y = 0; y < 2; ++y)
        {
            [unroll]
            for (int x = 0; x < 2; ++x)
            {
                bool tapResident;
                const float tapShadow = sampleVirtualShadowBilinear(
                    shadowMap, linearShadowMap, virtualPixel + float2(x - 0.5, y - 0.5), level, pageTable,
                    currentDepth - bias, tapResident);
                if (!tapResident) continue;
                filteredShadow += tapShadow;
                totalWeight += 1.0;
            }
        }
        return totalWeight > 0.0 ? filteredShadow / totalWeight : 0.0;
    }

    // The four logical probes cheaply reject uniform regions. A full Poisson
    // PCF16 is paid only where the footprint crosses a shadow silhouette.
    float initialShadow = 0.0;
    uint initialTapCount = 0;
    [unroll]
    for (int y = 0; y < 2; ++y)
    {
        [unroll]
        for (int x = 0; x < 2; ++x)
        {
            bool tapResident;
            const float tapShadow = sampleVirtualShadowBilinear(
                shadowMap, linearShadowMap, virtualPixel + float2(x - 0.5, y - 0.5), level, pageTable,
                currentDepth - bias, tapResident);
            if (!tapResident) continue;
            initialShadow += tapShadow;
            ++initialTapCount;
        }
    }
    initialShadow *= 0.25;
    if (initialTapCount == 4 && (initialShadow <= 0.001 || initialShadow >= 0.999))
        return initialShadow;

    float filteredShadow = 0.0;
    float totalWeight = 0.0;
    [unroll]
    for (uint tap = 0; tap < 16; ++tap)
    {
        const float2 offset = float2(
            poisson[tap].x * rotationCos - poisson[tap].y * rotationSin,
            poisson[tap].x * rotationSin + poisson[tap].y * rotationCos);
        bool tapResident;
        const float tapShadow = sampleVirtualShadowBilinear(
            shadowMap, linearShadowMap, virtualPixel + offset * 1.25, level, pageTable,
            currentDepth - bias, tapResident);
        if (!tapResident) continue;
        filteredShadow += tapShadow;
        totalWeight += 1.0;
    }
    return totalWeight > 0.0 ? filteredShadow / totalWeight : 0.0;
}

float shadowFootprintInTexels(float3 worldPosition, float4x4 clipMatrix)
{
    const float4 lightClip = mul(float4(worldPosition, 1.0), clipMatrix);
    if (abs(lightClip.w) < 1.0e-6)
        return 0.0;
    const float2 uv = lightClip.xy / lightClip.w * 0.5 + 0.5;
    return shadowTexelFootprintFromGradients(ddx(uv), ddx(uv), ddy(uv), ddy(uv));
}

uint selectVirtualShadowLevel(float3 worldPosition, float4x4 clipMatrices[7],
                              const uint shadowQuality, out float footprintInTexels)
{
    const float threshold = shadowTexelFootprintThreshold(shadowQuality);
    footprintInTexels = 0.0;
    [unroll]
    for (uint level = 0; level < SHADOW_CLIP_LEVELS; ++level)
    {
        const float4 lightClip = mul(float4(worldPosition, 1.0), clipMatrices[level]);
        if (abs(lightClip.w) < 1.0e-6) continue;
        const float2 uv = lightClip.xy / lightClip.w * 0.5 + 0.5;
        if (any(uv < 0.0) || any(uv >= 1.0)) continue;

        // This is the same LOD rule as receiver marking, but uses both
        // screen-space axes.  Sampling must never let incidental L0 cache
        // residency override the requested geometric LOD.
        const float levelFootprint = shadowFootprintInTexels(worldPosition, clipMatrices[level]);
        if (levelFootprint <= threshold || level + 1 == SHADOW_CLIP_LEVELS)
        {
            footprintInTexels = levelFootprint;
            return level;
        }
    }
    return SHADOW_CLIP_LEVELS - 1;
}

float sampleVirtualShadow(Sampler2DShadow shadowMap, Sampler2DShadow linearShadowMap,
                          Sampler2D shadowDepthMap,
                          float3 worldPosition,
                          float3 normal, float3 lightDirection,
                          float4x4 clipMatrices[7], StructuredBuffer<uint4> pageTable,
                          uint shadowQuality, uint2 pixelCoordinate,
                          uint temporalSampleIndex, bool temporalShadowJitter,
                          out ShadowSampleDebug debug)
{
    debug.blockerCount = 0.0;
    debug.penumbraRadius = 0.0;
    debug.desiredClipLevel = 0;
    debug.resolvedClipLevel = 0;
    debug.virtualPage = 0;
    bool resident;
    float desiredFootprintInTexels;
    const uint desiredLevel = selectVirtualShadowLevel(
        worldPosition, clipMatrices, shadowQuality, desiredFootprintInTexels);
    debug.desiredClipLevel = desiredLevel;
    debug.resolvedClipLevel = desiredLevel;
    [loop]
    for (uint level = desiredLevel; level < SHADOW_CLIP_LEVELS; ++level)
    {
        float clipEdge;
        float blockerCount;
        float penumbraRadius;
        uint2 virtualPage;
        float shadow = sampleVirtualShadowLevel(
            shadowMap, linearShadowMap, shadowDepthMap, worldPosition, normal, lightDirection,
            clipMatrices[level], level, pageTable, shadowQuality, pixelCoordinate,
            temporalSampleIndex, temporalShadowJitter, resident, clipEdge,
            blockerCount, penumbraRadius, virtualPage);
        if (resident)
        {
            debug.blockerCount = blockerCount;
            debug.penumbraRadius = penumbraRadius;
            debug.resolvedClipLevel = level;
            debug.virtualPage = virtualPage;
            // Cross-fade both at the geometric clipmap edge and across the
            // screen-space footprint threshold.  The latter keeps adjacent
            // pixels from abruptly switching between independently rendered
            // clip levels, which otherwise appears as horizontal LOD seams.
            const float footprintInTexels = level == desiredLevel
                ? desiredFootprintInTexels
                : shadowFootprintInTexels(worldPosition, clipMatrices[level]);
            const float threshold = shadowTexelFootprintThreshold(shadowQuality);
            const float lodBlend = smoothstep(threshold * 0.70, threshold, footprintInTexels);
            const float clipBlend = smoothstep(0.75, 0.95, clipEdge);
            const float transition = max(lodBlend, clipBlend);
            // Do not blend with an absent next-level page: it is safer to
            // keep the valid level until its fallback becomes resident.
            if (level + 1 < SHADOW_CLIP_LEVELS && transition > 0.0)
            {
                bool nextResident;
                float nextClipEdge;
                float nextBlockerCount;
                float nextPenumbraRadius;
                uint2 nextVirtualPage;
                float nextShadow = sampleVirtualShadowLevel(
                    shadowMap, linearShadowMap, shadowDepthMap, worldPosition, normal, lightDirection, clipMatrices[level + 1], level + 1,
                    pageTable, shadowQuality, pixelCoordinate, temporalSampleIndex,
                    temporalShadowJitter, nextResident, nextClipEdge,
                    nextBlockerCount, nextPenumbraRadius, nextVirtualPage);
                if (nextResident)
                    shadow = lerp(shadow, nextShadow, transition);
            }
            return shadow;
        }
    }
    return 0.0;
}

float3 shadowDebugColor(uint view, ShadowSampleDebug debug)
{
    if (view == SHADOW_DEBUG_BLOCKER_COUNT)
        return saturate(debug.blockerCount / 8.0).xxx;
    if (view == SHADOW_DEBUG_PENUMBRA_RADIUS)
    {
        const float t = saturate(debug.penumbraRadius / 6.0);
        return float3(t, 0.15 + 0.85 * (1.0 - abs(2.0 * t - 1.0)), 1.0 - t);
    }
    if (view == SHADOW_DEBUG_DESIRED_CLIP_LEVEL || view == SHADOW_DEBUG_RESOLVED_CLIP_LEVEL)
    {
        static const float3 colors[7] = {
            float3(0.90, 0.20, 0.20), float3(0.95, 0.60, 0.15), float3(0.90, 0.90, 0.20),
            float3(0.20, 0.80, 0.30), float3(0.15, 0.70, 0.90), float3(0.30, 0.35, 0.95),
            float3(0.75, 0.25, 0.90)};
        const uint level = view == SHADOW_DEBUG_DESIRED_CLIP_LEVEL
            ? debug.desiredClipLevel : debug.resolvedClipLevel;
        return colors[min(level, 6u)];
    }
    if (view == SHADOW_DEBUG_FALLBACK_DELTA)
    {
        const uint delta = max(debug.resolvedClipLevel, debug.desiredClipLevel) - debug.desiredClipLevel;
        if (delta == 0u) return float3(0.10, 0.90, 0.20);
        if (delta == 1u) return float3(1.00, 0.90, 0.10);
        if (delta == 2u) return float3(1.00, 0.45, 0.05);
        return float3(0.95, 0.05, 0.05);
    }
    // A deterministic page hash makes virtual-page boundaries and residency
    // churn visible without exposing physical atlas placement.
    uint hash = debug.virtualPage.x * 1664525u + debug.virtualPage.y * 1013904223u +
                debug.resolvedClipLevel * 2246822519u;
    return float3(float(hash & 255u), float((hash >> 8u) & 255u),
                  float((hash >> 16u) & 255u)) / 255.0;
}

// Compatibility path for the standalone sample shader.
float samplePcfShadow(Sampler2DShadow shadowMap, float4 lightSpacePosition)
{
    float3 projected = lightSpacePosition.xyz / lightSpacePosition.w;
    float2 uv = projected.xy * 0.5 + 0.5;
    float currentDepth = projected.z;
    if (any(uv <= 0.0) || any(uv >= 1.0) || currentDepth <= 0.0 || currentDepth >= 1.0)
        return 0.0;
    float bias = max(LEGACY_MIN_SHADOW_BIAS,
                     LEGACY_SLOPE_SHADOW_BIAS *
                         max(abs(ddx(currentDepth)), abs(ddy(currentDepth))));
    return 1.0 - shadowMap.SampleCmpLevelZero(uv, currentDepth - bias);
}
"
         %42 = OpString "C:/Users/Bartosz Kasyna/CLionProjects/GamEngine/Engine/Shaders/Common/ShadowSampling.slang"
         %43 = OpString "// Reflection sources are resolved by confidence rather than added. Lower-
// confidence screen-space/RT results blend into stable probe/sky fallback,
// which avoids hard ownership changes and reflection popping at screen edges.
struct ReflectionCandidate
{
    float3 radiance;
    float confidence;
};

float3 resolveReflection(ReflectionCandidate rayTraced, ReflectionCandidate screenSpace,
                         ReflectionCandidate localProbe, ReflectionCandidate sky)
{
    float3 result = sky.radiance;
    result = lerp(result, localProbe.radiance, saturate(localProbe.confidence));
    result = lerp(result, screenSpace.radiance, saturate(screenSpace.confidence));
    result = lerp(result, rayTraced.radiance, saturate(rayTraced.confidence));
    return result;
}
"
         %45 = OpString "C:/Users/Bartosz Kasyna/CLionProjects/GamEngine/Engine/Shaders/Common/ReflectionFallback.slang"
               OpSource Slang 1
