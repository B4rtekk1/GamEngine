#version 450

layout(local_size_x = 256) in;

struct Particle {
    vec4 positionLife;
    vec4 velocitySize;
    vec4 color;
    vec4 spawnData;
};

layout(std430, set = 0, binding = 0) buffer Particles { Particle particles[]; };
layout(std430, set = 0, binding = 2) buffer ActiveIndices { uint activeIndices[]; };
layout(std430, set = 0, binding = 3) buffer DrawCommand { uint vertexCount; uint instanceCount; uint firstVertex; uint firstInstance; } drawCommand;
struct Collider { vec4 center; vec4 halfExtents; };
layout(std430, set = 0, binding = 4) readonly buffer Colliders { Collider colliders[]; };
layout(push_constant) uniform Simulation {
    float deltaTime;
    uint spawnStart;
    uint spawnCount;
    uint maxParticles;
    uint spawnSeed;
    uint colliderCount;
    float _padding1;
    float _padding2;
    vec4 emitterPositionMinLife;
    vec4 minVelocityMinSize;
    vec4 maxVelocity;
    vec4 color;
    vec4 maxLifeMaxSize;
    vec4 smokeDynamics;
} sim;

uint hash(uint value) {
    value ^= value >> 16u;
    value *= 0x7feb352du;
    value ^= value >> 15u;
    value *= 0x846ca68bu;
    value ^= value >> 16u;
    return value;
}

float random(inout uint state) {
    state = hash(state);
    return float(state) * (1.0 / 4294967296.0);
}

// A divergence-free field is considerably more convincing than independent
// per-particle jitter: neighbouring particles keep forming the same rolling
// billows while the plume rises.
vec3 curlNoise(vec3 p) {
    const float a = 1.73;
    const float b = 2.31;
    const float c = 2.87;
    return vec3(cos(p.z * c) * c - cos(p.y * b) * b,
                cos(p.x * a) * a - cos(p.z * c) * c,
                cos(p.y * b) * b - cos(p.x * a) * a);
}

// Signed distance and outward normal for the expanded obstacle.  Unlike a
// boolean overlap test, this lets the flow react before it reaches a wall.
float aabbDistance(vec3 point, vec3 center, vec3 extents, out vec3 normal) {
    vec3 relative = point - center;
    vec3 q = abs(relative) - extents;
    vec3 outside = max(q, vec3(0.0));
    float outsideLength = length(outside);
    if (outsideLength > 0.0001) {
        normal = sign(relative) * outside / outsideLength;
        return outsideLength;
    }

    // The point is inside. Choose the closest face so it can be pushed out.
    if (q.x >= q.y && q.x >= q.z) {
        normal = vec3(relative.x >= 0.0 ? 1.0 : -1.0, 0.0, 0.0);
    } else if (q.y >= q.z) {
        normal = vec3(0.0, relative.y >= 0.0 ? 1.0 : -1.0, 0.0);
    } else {
        normal = vec3(0.0, 0.0, relative.z >= 0.0 ? 1.0 : -1.0);
    }
    return max(q.x, max(q.y, q.z));
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= sim.maxParticles) return;
    Particle p = particles[id];
    float dt = min(sim.deltaTime, 0.1);

    if (p.positionLife.w > 0.0) {
        float age = clamp(1.0 - p.positionLife.w / max(p.spawnData.z, 0.001), 0.0, 1.0);
        // Fast enough to feel alive at the source, then gradually swelling
        // into a broad cloud.  The cubic curve avoids a mechanical scale-up.
        float expansionAge = 1.0 - age;
        float expansion = 1.0 - expansionAge * expansionAge *
                          (0.6 + 0.4 * expansionAge);
        p.velocitySize.w = mix(p.spawnData.x, p.spawnData.y, expansion);
        // Keep lateral turbulence deliberately subtle. The previous curl
        // field plus radial expansion produced a symmetric V-shaped split;
        // real smoke initially rises as one column and only then meanders.
        vec3 swirl = curlNoise(p.positionLife.xyz * 0.72 + vec3(2.1, 0.0, 4.6)) * 0.20;
        swirl.y *= 0.35;
        p.velocitySize.xyz += (vec3(0.0, sim.smokeDynamics.x, 0.0) +
                               swirl * sim.smokeDynamics.z) * dt;
        p.velocitySize.xyz *= 1.0 / (1.0 + sim.smokeDynamics.y * dt);

        // In the approach zone the stream is split into two tangential paths
        // and gently lifted.  It starts this turn before contact, which is
        // what makes smoke visibly wrap around an obstacle instead of simply
        // bouncing from it.
        vec3 nextPosition = p.positionLife.xyz + p.velocitySize.xyz * dt;
        for (uint c = 0u; c < uint(sim.colliderCount); ++c) {
            vec3 center = colliders[c].center.xyz;
            vec3 extents = colliders[c].halfExtents.xyz +
                           vec3(max(sim.smokeDynamics.w, p.velocitySize.w * 0.35));
            vec3 normal;
            float distance = aabbDistance(p.positionLife.xyz, center, extents, normal);
            float flowRange = max(0.85, p.velocitySize.w * 4.0);
            float proximity = 1.0 - smoothstep(0.0, flowRange, max(distance, 0.0));
            if (proximity <= 0.0) continue;

            vec3 side = cross(vec3(0.0, 1.0, 0.0), normal);
            if (dot(side, side) < 0.001) side = cross(normal, vec3(1.0, 0.0, 0.0));
            side = normalize(side);
            float branch = (hash(id + c * 1664525u) & 1u) == 0u ? -1.0 : 1.0;
            vec3 around = normalize(side * branch + vec3(0.0, 0.38, 0.0));
            float incoming = max(0.0, -dot(p.velocitySize.xyz, normal));
            float flowStrength = (2.4 + 3.0 * length(p.velocitySize.xyz));
            p.velocitySize.xyz += (normal * incoming * 2.0 + around * flowStrength) *
                                  proximity * dt;
            // Resolve the predicted position in the same pass.  This keeps
            // the approach force and exact penetration test at one collider
            // traversal per particle.
            nextPosition = p.positionLife.xyz + p.velocitySize.xyz * dt;
            vec3 relative = nextPosition - center;
            if (all(lessThan(abs(relative), extents))) {
                vec3 margin = extents - abs(relative);
                vec3 normal = (margin.x <= margin.y && margin.x <= margin.z)
                    ? vec3(relative.x >= 0.0 ? 1.0 : -1.0, 0.0, 0.0)
                    : (margin.y <= margin.z ? vec3(0.0, relative.y >= 0.0 ? 1.0 : -1.0, 0.0)
                                             : vec3(0.0, 0.0, relative.z >= 0.0 ? 1.0 : -1.0));
                float penetration = min(min(margin.x, margin.y), margin.z);
                nextPosition += normal * (penetration + 0.001);
                float intoSurface = dot(p.velocitySize.xyz, normal);
                if (intoSurface < 0.0) p.velocitySize.xyz -= normal * intoSurface;
                p.velocitySize.xyz *= 0.82;
            }
        }
        p.positionLife.xyz = nextPosition;
        p.positionLife.w -= dt;
        // Preserve the artist-selected opacity; only the final part of life
        // dissipates.  The fragment shader supplies the soft, noisy edge.
        float fadeIn = smoothstep(0.0, 0.12, age);
        float fadeOut = smoothstep(0.0, 1.15, p.positionLife.w);
        p.color.a = p.spawnData.w * fadeIn * fadeOut;
    }

    // The CPU supplies only the range of slots emitted this frame. Random
    // particle attributes are generated deterministically on the GPU.
    uint relative = (id + sim.maxParticles - sim.spawnStart) % sim.maxParticles;
    if (relative < sim.spawnCount) {
        uint state = sim.spawnSeed + relative;
        // Emit from a small disk rather than a mathematical point. This keeps
        // the base of the plume dense while avoiding a visible needle shape.
        float angle = random(state) * 6.28318530718;
        float radius = sqrt(random(state)) * max(sim.minVelocityMinSize.w, 0.08) * 1.35;
        vec3 spawnOffset = vec3(cos(angle) * radius,
                                random(state) * radius * 0.22,
                                sin(angle) * radius);
        float lifetime = mix(sim.emitterPositionMinLife.w, sim.maxLifeMaxSize.x, random(state));
        float initialSize = mix(sim.minVelocityMinSize.w, sim.maxLifeMaxSize.y, random(state));
        float finalSize = initialSize * mix(1.65, 2.35, random(state));
        p.positionLife = vec4(sim.emitterPositionMinLife.xyz + spawnOffset, lifetime);
        p.velocitySize = vec4(
            mix(sim.minVelocityMinSize.xyz, sim.maxVelocity.xyz, vec3(random(state), random(state), random(state))),
            initialSize);
        p.color = sim.color;
        p.spawnData = vec4(initialSize, finalSize, lifetime, sim.color.a);
    }
    particles[id] = p;
    if (p.positionLife.w > 0.0) {
        const uint compactIndex = atomicAdd(drawCommand.instanceCount, 1u);
        activeIndices[compactIndex] = id;
    }
}
