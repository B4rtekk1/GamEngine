if(NOT DEFINED GAME_ROOT OR NOT DEFINED OUTPUT)
    message(FATAL_ERROR "GenerateGameScriptsModule.cmake requires GAME_ROOT and OUTPUT")
endif()

file(GLOB_RECURSE GAME_SCRIPT_SOURCES "${GAME_ROOT}/Assets/Scripts/*.cpp")

set(generated "// Generated by GamEngine. Do not edit.\n")
string(APPEND generated "#include \"Engine/Scripting/ScriptModuleApi.h\"\n\n")
set(registrations "")
foreach(source IN LISTS GAME_SCRIPT_SOURCES)
    get_filename_component(stem "${source}" NAME_WE)
    get_filename_component(source_directory "${source}" DIRECTORY)
    set(header "${source_directory}/${stem}.h")
    if(NOT EXISTS "${header}")
        message(FATAL_ERROR "Script source ${source} has no matching header ${header}")
    endif()
    file(READ "${header}" header_contents)
    string(REGEX MATCH "class[ \t]+([A-Za-z_][A-Za-z0-9_]*)[ \t]*(final[ \t]*)?:[ \t]*public[ \t]+Engine::Script" match "${header_contents}")
    if(NOT match)
        message(FATAL_ERROR "Could not find an Engine::Script class in ${header}")
    endif()
    set(class_name "${CMAKE_MATCH_1}")
    file(RELATIVE_PATH relative_source "${GAME_ROOT}" "${source}")
    file(TO_CMAKE_PATH "${relative_source}" relative_source)
    file(RELATIVE_PATH relative_header "${GAME_ROOT}/Assets/Scripts" "${header}")
    file(TO_CMAKE_PATH "${relative_header}" relative_header)
    string(APPEND generated "#include \"${relative_header}\"\n")
    string(APPEND registrations "    registrar->registerScript<${class_name}>(\"${class_name}\", \"${relative_source}\");\n")
endforeach()
string(APPEND generated "\nextern \"C\" GAME_SCRIPT_API std::uint32_t GE_GetScriptApiVersion() {\n    return ENGINE_SCRIPT_API_VERSION;\n}\n\n")
string(APPEND generated "extern \"C\" GAME_SCRIPT_API void GE_RegisterGameScripts(Engine::ScriptModuleRegistrar *registrar) {\n${registrations}}\n")
file(WRITE "${OUTPUT}" "${generated}")
