if(NOT DEFINED GAME_ROOT OR NOT DEFINED OUTPUT)
    message(FATAL_ERROR "GenerateGameScriptsModule.cmake requires GAME_ROOT and OUTPUT")
endif()

file(GLOB_RECURSE GAME_SCRIPT_SOURCES "${GAME_ROOT}/Assets/Scripts/*.cpp")

set(generated "// Generated by GamEngine. Do not edit.\n")
string(APPEND generated "#include \"Engine/Scripting/ScriptModuleApi.h\"\n\n")
set(registrations "")

# Return the parenthesis balance of text, ignoring parentheses in string
# literals.  This lets GE_PROPERTY contain calls such as Range(0, 20) and be
# split over several lines without relying on a fragile one-regex parser.
function(ge_parenthesis_delta input output)
    string(LENGTH "${input}" length)
    set(delta 0)
    set(in_string FALSE)
    set(index 0)
    while(index LESS length)
        string(SUBSTRING "${input}" ${index} 1 character)
        if(character STREQUAL "\"")
            if(in_string)
                set(in_string FALSE)
            else()
                set(in_string TRUE)
            endif()
        elseif(NOT in_string AND character STREQUAL "(")
            math(EXPR delta "${delta} + 1")
        elseif(NOT in_string AND character STREQUAL ")")
            math(EXPR delta "${delta} - 1")
        endif()
        math(EXPR index "${index} + 1")
    endwhile()
    set(${output} ${delta} PARENT_SCOPE)
endfunction()

function(ge_property_attributes property output)
    set(attributes "")

    string(REGEX MATCHALL "Range[ \t\r\n]*\\([^)]*\\)" ranges "${property}")
    foreach(range IN LISTS ranges)
        string(REGEX REPLACE "^Range[ \t\r\n]*\\([ \t\r\n]*" "" values "${range}")
        string(REGEX REPLACE "[ \t\r\n]*\\)$" "" values "${values}")
        string(REPLACE "," ";" values "${values}")
        list(LENGTH values value_count)
        if(value_count EQUAL 2)
            list(GET values 0 minimum)
            list(GET values 1 maximum)
            string(STRIP "${minimum}" minimum)
            string(STRIP "${maximum}" maximum)
            list(APPEND attributes "Engine::ScriptRangeAttribute{.min = ${minimum}, .max = ${maximum}}")
        else()
            message(WARNING "Ignoring malformed Range attribute: ${range}")
        endif()
    endforeach()

    foreach(attribute_type IN ITEMS Tooltip Header)
        string(REGEX MATCHALL "${attribute_type}[ \t\r\n]*\\([^)]*\\)" matches "${property}")
        foreach(match IN LISTS matches)
            string(REGEX REPLACE "^${attribute_type}[ \t\r\n]*\\(" "" text "${match}")
            string(REGEX REPLACE "\\)$" "" text "${text}")
            string(STRIP "${text}" text)
            list(APPEND attributes "Engine::Script${attribute_type}Attribute{.text = ${text}}")
        endforeach()
    endforeach()

    foreach(attribute_type IN ITEMS Min Max Step)
        string(REGEX MATCHALL "${attribute_type}[ \\t\\r\\n]*\\([^)]*\\)" matches "${property}")
        foreach(match IN LISTS matches)
            string(REGEX REPLACE "^${attribute_type}[ \\t\\r\\n]*\\(" "" value "${match}")
            string(REGEX REPLACE "\\)$" "" value "${value}")
            string(STRIP "${value}" value)
            list(APPEND attributes "Engine::Script${attribute_type}Attribute{.value = ${value}}")
        endforeach()
    endforeach()

    foreach(attribute_type IN ITEMS DisplayName FormerlySerializedAs)
        string(REGEX MATCHALL "${attribute_type}[ \\t\\r\\n]*\\([^)]*\\)" matches "${property}")
        foreach(match IN LISTS matches)
            string(REGEX REPLACE "^${attribute_type}[ \\t\\r\\n]*\\(" "" text "${match}")
            string(REGEX REPLACE "\\)$" "" text "${text}")
            string(STRIP "${text}" text)
            if(attribute_type STREQUAL "FormerlySerializedAs")
                list(APPEND attributes "Engine::ScriptFormerlySerializedAsAttribute{.name = ${text}}")
            else()
                list(APPEND attributes "Engine::ScriptDisplayNameAttribute{.text = ${text}}")
            endif()
        endforeach()
    endforeach()

    string(REGEX MATCH "Multiline[ \\t\\r\\n]*\\([^)]*\\)" multiline "${property}")
    if(multiline)
        string(REGEX REPLACE "^[^(]*\\(" "" lines "${multiline}")
        string(REGEX REPLACE "\\)$" "" lines "${lines}")
        string(STRIP "${lines}" lines)
        list(APPEND attributes "Engine::ScriptMultilineAttribute{.lines = ${lines}}")
    endif()
    foreach(marker IN ITEMS HideInInspector Angle Percentage)
        if(property MATCHES "(^|[^A-Za-z0-9_])${marker}[ \\t\\r\\n]*(\\(|$)")
            list(APPEND attributes "Engine::Script${marker}Attribute{}")
        endif()
    endforeach()

    string(REGEX MATCH "Space[ \\t\\r\\n]*\\([^)]*\\)" space "${property}")
    if(space)
        string(REGEX REPLACE "^[^(]*\\(" "" pixels "${space}")
        string(REGEX REPLACE "\\)$" "" pixels "${pixels}")
        string(STRIP "${pixels}" pixels)
        list(APPEND attributes "Engine::ScriptSpaceAttribute{.pixels = ${pixels}}")
    endif()

    if(property MATCHES "ReadOnly")
        list(APPEND attributes "Engine::ScriptReadOnlyAttribute{}")
    endif()

    if(attributes)
        string(JOIN ", " attributes_text ${attributes})
        set(${output} "{${attributes_text}}" PARENT_SCOPE)
    else()
        set(${output} "{}" PARENT_SCOPE)
    endif()
endfunction()

foreach(source IN LISTS GAME_SCRIPT_SOURCES)
    get_filename_component(stem "${source}" NAME_WE)
    get_filename_component(source_directory "${source}" DIRECTORY)
    set(header "${source_directory}/${stem}.h")
    if(NOT EXISTS "${header}")
        message(STATUS "Skipping ${source}: no matching script header")
        continue()
    endif()
    file(READ "${header}" header_contents)
    string(REGEX MATCH "class[ \t\r\n]+(GAME_API[ \t\r\n]+)?([A-Za-z_][A-Za-z0-9_]*)[ \t\r\n]*(final[ \t\r\n]*)?:[ \t\r\n]*public[ \t\r\n]+Engine::Script" match "${header_contents}")
    if(NOT match)
        message(STATUS "Skipping ${source}: no Engine::Script class found")
        continue()
    endif()
    set(class_name "${CMAKE_MATCH_2}")
    file(RELATIVE_PATH relative_source "${GAME_ROOT}" "${source}")
    file(TO_CMAKE_PATH "${relative_source}" relative_source)
    file(RELATIVE_PATH relative_header "${GAME_ROOT}/Assets/Scripts" "${header}")
    file(TO_CMAKE_PATH "${relative_header}" relative_header)
    string(APPEND generated "#include \"${relative_header}\"\n")
    string(APPEND registrations "    registrar->registerScript<${class_name}>(\"${class_name}\", \"${relative_source}\");\n")

    # Keep the public-field discovery deliberately limited to reflected scalar
    # engine types.  The generated accessors use pointer-to-member functions;
    # no object layout assumptions cross the DLL boundary.
    string(REPLACE "\r" "" header_contents "${header_contents}")
    string(REPLACE "\n" ";" header_lines "${header_contents}")
    set(in_public_section FALSE)
    set(property_text "")
    set(property_balance 0)
    foreach(line IN LISTS header_lines)
        if(in_public_section AND NOT property_text AND line MATCHES "^[ \\t]*GE_PROPERTY[ \\t]*\\(")
            set(property_text "${line}")
            ge_parenthesis_delta("${line}" property_balance)
            if(property_balance EQUAL 0)
                # Support both the conventional next-line declaration and a
                # compact `GE_PROPERTY(...) float value;` declaration.
                string(REGEX REPLACE "^[ \\t]*GE_PROPERTY.*\\)[ \\t]*" "" line "${line}")
                if(NOT line)
                    # The declaration is expected on the next line.
                    continue()
                endif()
            else()
                continue()
            endif()
        elseif(property_text AND NOT property_balance EQUAL 0)
            string(APPEND property_text "\n${line}")
            ge_parenthesis_delta("${line}" line_balance)
            math(EXPR property_balance "${property_balance} + ${line_balance}")
            continue()
        endif()

        if(line MATCHES "^[ \\t]*public:[ \\t]*$")
            set(in_public_section TRUE)
        elseif(line MATCHES "^[ \\t]*(private|protected):")
            set(in_public_section FALSE)
            set(property_text "")
            set(property_balance 0)
        elseif(in_public_section AND line MATCHES "^[ \\t]*(bool|int|float|double|Engine::Vec3|Vec3|Engine::Color|Color|std::string)[ \\t]+([A-Za-z_][A-Za-z0-9_]*)")
            set(field_type "${CMAKE_MATCH_1}")
            set(field_name "${CMAKE_MATCH_2}")
            if(property_text)
                ge_property_attributes("${property_text}" attributes)
                set(property_text "")
                set(property_balance 0)
                string(APPEND registrations "    registrar->registerField<${class_name}, &${class_name}::${field_name}>(\"${class_name}\", \"${field_name}\", ${attributes});\n")
            else()
                string(APPEND registrations "    registrar->registerField<${class_name}, &${class_name}::${field_name}>(\"${class_name}\", \"${field_name}\");\n")
            endif()
        endif()
    endforeach()
endforeach()
string(APPEND generated "\nextern \"C\" GAME_SCRIPT_API std::uint32_t GE_GetScriptApiVersion() {\n    return ENGINE_SCRIPT_API_VERSION;\n}\n\n")
string(APPEND generated "extern \"C\" GAME_SCRIPT_API void GE_RegisterGameScripts(Engine::ScriptModuleRegistrar *registrar) {\n${registrations}}\n")
file(WRITE "${OUTPUT}" "${generated}")
