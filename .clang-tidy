Checks: >-
  -*,
  bugprone-*,
  performance-*,
  portability-*,
  readability-*,
  modernize-use-nullptr,
  modernize-use-override,
  cppcoreguidelines-owning-memory
WarningsAsErrors: ''
HeaderFilterRegex: 'Engine/(Include|Source)/.*'
FormatStyle: file
CheckOptions:
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case
