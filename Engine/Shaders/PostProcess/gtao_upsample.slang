struct VertexOutput { float4 position:SV_Position; [[vk::location(0)]] float2 uv; }; [shader("vertex")] VertexOutput vertexMain(uint i:SV_VertexID){VertexOutput o;float2 p=float2((i<<1)&2,i&2);o.uv=p;o.position=float4(p*2-1,0,1);return o;}
[[vk::binding(0,0)]] Sampler2D halfAo; [[vk::binding(1,0)]] Sampler2D auxiliary; [[vk::binding(2,0)]] Sampler2D depthTexture; struct Settings { float4x4 inverseProjection; float inverseFullWidth,inverseFullHeight,depthSigma,padding; float inverseHalfWidth,inverseHalfHeight,padding0,padding1; }; [[vk::push_constant]] ConstantBuffer<Settings> settings; struct Input { [[vk::location(0)]] float2 uv; }; struct Output { [[vk::location(0)]] float4 value:SV_Target; };
float viewDepth(float2 uv,float z){float4 p=mul(float4(uv*2-1,z,1),settings.inverseProjection);return max(-p.z/max(p.w,1e-6),1e-4);}
// Reconstruct from the four actual half-resolution texels surrounding the
// full-resolution pixel.  Coordinates are in texel space so this remains
// correct for odd-sized render targets as well.
[shader("fragment")] Output fragmentMain(Input i) { Output o; float z=depthTexture.SampleLevel(i.uv,0).r; if(z>=0.999999){o.value=float4(1,1,1,1);return o;} float center=viewDepth(i.uv,z); float2 halfTexel=float2(settings.inverseHalfWidth,settings.inverseHalfHeight); float2 halfPosition=i.uv/halfTexel-.5; float2 base=floor(halfPosition); float2 fraction=frac(halfPosition); float sum=0,wSum=0; [unroll] for(int y=0;y<=1;++y) [unroll] for(int x=0;x<=1;++x) { float2 offset=float2(x,y); float2 uv=clamp((base+offset+.5)*halfTexel,.5*halfTexel,1-.5*halfTexel); float s=halfAo.SampleLevel(uv,0).r; float sampleDepth=auxiliary.SampleLevel(uv,0).r; float bilinearWeight=(x==0?1-fraction.x:fraction.x)*(y==0?1-fraction.y:fraction.y); float depthWeight=exp(-abs(sampleDepth-center)*settings.depthSigma/max(center,1e-3)); float w=bilinearWeight*depthWeight; sum+=s*w; wSum+=w; } float ao=saturate(sum/max(wSum,1e-5)); o.value=float4(ao,ao,ao,1);return o;}
