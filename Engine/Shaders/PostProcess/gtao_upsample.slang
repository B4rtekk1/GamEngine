struct VertexOutput { float4 position:SV_Position; [[vk::location(0)]] float2 uv; }; [shader("vertex")] VertexOutput vertexMain(uint i:SV_VertexID){VertexOutput o;float2 p=float2((i<<1)&2,i&2);o.uv=p;o.position=float4(p*2-1,0,1);return o;}
[[vk::binding(0,0)]] Sampler2D halfAo; [[vk::binding(1,0)]] Sampler2D depthTexture; struct Settings { float4x4 inverseProjection; float inverseFullWidth,inverseFullHeight,depthSigma,padding; }; [[vk::push_constant]] ConstantBuffer<Settings> settings; struct Input { [[vk::location(0)]] float2 uv; }; struct Output { [[vk::location(0)]] float4 value:SV_Target; };
float viewDepth(float2 uv){float z=depthTexture.SampleLevel(uv,0).r;float4 p=mul(float4(uv*2-1,z,1),settings.inverseProjection);return max(-p.z/max(p.w,1e-6),1e-4);}
[shader("fragment")] Output fragmentMain(Input i) { Output o; float center=viewDepth(i.uv); float2 ht=float2(settings.inverseFullWidth,settings.inverseFullHeight); float sum=0,wSum=0; [unroll] for(int y=-1;y<=1;++y) [unroll] for(int x=-1;x<=1;++x){float2 uv=clamp(i.uv+float2(x,y)*ht,0,1);float4 s=halfAo.SampleLevel(uv,0);float w=exp(-abs(s.y-center)*settings.depthSigma/max(center,1e-3));sum+=s.x*w;wSum+=w;} float ao=saturate(sum/max(wSum,1e-5)); o.value=float4(ao,ao,ao,1);return o;}
