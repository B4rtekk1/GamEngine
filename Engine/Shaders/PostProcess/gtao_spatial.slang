struct VertexOutput { float4 position:SV_Position; [[vk::location(0)]] float2 uv; }; [shader("vertex")] VertexOutput vertexMain(uint i:SV_VertexID){VertexOutput o;float2 p=float2((i<<1)&2,i&2);o.uv=p;o.position=float4(p*2-1,0,1);return o;}
[[vk::binding(0,0)]] Sampler2D rawAo; [[vk::binding(1,0)]] Sampler2D depthTexture; [[vk::binding(2,0)]] Sampler2D rawDepth;
struct Settings { float inverseWidth,inverseHeight,depthSigma,normalSigma; }; [[vk::push_constant]] ConstantBuffer<Settings> settings; struct Input { [[vk::location(0)]] float2 uv; }; struct Output { [[vk::location(0)]] float4 value:SV_Target; };
[shader("fragment")] Output fragmentMain(Input i) { Output o; float4 c=rawAo.SampleLevel(i.uv,0); float sum=0,wSum=0; float2 t=float2(settings.inverseWidth,settings.inverseHeight); [unroll] for(int y=-2;y<=2;++y) [unroll] for(int x=-2;x<=2;++x) { float2 uv=clamp(i.uv+float2(x,y)*t,0,1); float4 s=rawAo.SampleLevel(uv,0); float spatial=exp(-.5*(x*x+y*y)/2.0); float edge=exp(-abs(s.y-c.y)*settings.depthSigma); float w=spatial*edge; sum+=s.x*w; wSum+=w; } o.value=float4(sum/max(wSum,1e-5),c.y,0,1); return o; }
