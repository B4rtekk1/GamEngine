struct VertexOutput { float4 position:SV_Position; [[vk::location(0)]] float2 uv; }; [shader("vertex")] VertexOutput vertexMain(uint i:SV_VertexID){VertexOutput o;float2 p=float2((i<<1)&2,i&2);o.uv=p;o.position=float4(p*2-1,0,1);return o;}
[[vk::binding(0,0)]] Sampler2D currentAo; [[vk::binding(1,0)]] Sampler2D historyAo; [[vk::binding(2,0)]] Sampler2D velocity;
struct Settings { float inverseWidth,inverseHeight,historyWeight,padding; }; [[vk::push_constant]] ConstantBuffer<Settings> settings; struct Input { [[vk::location(0)]] float2 uv; }; struct Output { [[vk::location(0)]] float4 value:SV_Target; };
[shader("fragment")] Output fragmentMain(Input i) { Output o; float4 c=currentAo.SampleLevel(i.uv,0); if(settings.historyWeight<=0){o.value=c;return o;} float2 historyUv=i.uv-velocity.SampleLevel(i.uv,0).xy; if(any(historyUv<0)||any(historyUv>1)){o.value=c;return o;} float4 history=historyAo.SampleLevel(historyUv,0); float historyWeight=abs(history.y-c.y)<max(.02,c.y*.02)?settings.historyWeight:0; float h=history.x; float2 t=float2(settings.inverseWidth,settings.inverseHeight); float lo=1,hi=0; [unroll] for(int y=-1;y<=1;++y) [unroll] for(int x=-1;x<=1;++x){float v=currentAo.SampleLevel(clamp(i.uv+float2(x,y)*t,0,1),0).x;lo=min(lo,v);hi=max(hi,v);} h=clamp(h,lo-.08,hi+.08); o.value=float4(lerp(c.x,h,historyWeight),c.y,0,1);return o;}
