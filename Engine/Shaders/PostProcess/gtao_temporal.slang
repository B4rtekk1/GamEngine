struct VertexOutput { float4 position:SV_Position; [[vk::location(0)]] float2 uv; }; [shader("vertex")] VertexOutput vertexMain(uint i:SV_VertexID){VertexOutput o;float2 p=float2((i<<1)&2,i&2);o.uv=p;o.position=float4(p*2-1,0,1);return o;}
[[vk::binding(0,0)]] Sampler2D currentAo; [[vk::binding(1,0)]] Sampler2D historyAo; [[vk::binding(2,0)]] Sampler2D velocity; [[vk::binding(3,0)]] Sampler2D auxiliary;
struct Settings { float inverseWidth,inverseHeight,historyWeight,padding; }; [[vk::push_constant]] ConstantBuffer<Settings> settings; struct Input { [[vk::location(0)]] float2 uv; }; struct Output { [[vk::location(0)]] float4 value:SV_Target; };
[shader("fragment")] Output fragmentMain(Input i) { Output o; float c=currentAo.SampleLevel(i.uv,0).r, depth=auxiliary.SampleLevel(i.uv,0).r; if(settings.historyWeight<=0){o.value=float4(c,depth,0,1);return o;} float2 historyUv=i.uv-velocity.SampleLevel(i.uv,0).xy; if(any(historyUv<0)||any(historyUv>1)){o.value=float4(c,depth,0,1);return o;} float2 history=historyAo.SampleLevel(historyUv,0).rg; float weight=abs(history.y-depth)<max(.02,depth*.02)?settings.historyWeight:0; float2 t=float2(settings.inverseWidth,settings.inverseHeight); float lo=1,hi=0; [unroll] for(int y=-1;y<=1;++y) [unroll] for(int x=-1;x<=1;++x){float v=currentAo.SampleLevel(clamp(i.uv+float2(x,y)*t,0,1),0).r;lo=min(lo,v);hi=max(hi,v);} o.value=float4(lerp(c,clamp(history.x,lo-.08,hi+.08),weight),depth,0,1);return o;}
