<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Installer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="GamEngine Setup">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid Padding="32" ColumnSpacing="28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="24">
            <TextBlock Text="GamEngine" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="01  Welcome" />
            <TextBlock Text="02  Install" FontWeight="SemiBold" />
            <TextBlock Text="03  Progress" />
            <TextBlock Text="04  Done" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="16">
            <TextBlock x:Name="Heading" Text="Install GamEngine" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Text="Choose an installation folder. You can install future versions in the same folder." TextWrapping="Wrap" />
            <TextBox x:Name="InstallPath" Header="Installation folder" />
            <CheckBox x:Name="DesktopShortcut" Content="Create a desktop shortcut" IsChecked="True" />
            <CheckBox x:Name="StartMenuShortcut" Content="Add to Start menu" IsChecked="True" />
            <ProgressBar x:Name="InstallProgress" Minimum="0" Maximum="100" Value="0" />
            <TextBlock x:Name="StatusText" Text="Ready to install" TextWrapping="Wrap" />
            <Button x:Name="InstallButton" Content="Install" HorizontalAlignment="Right" Click="InstallButton_Click" />
        </StackPanel>
    </Grid>
</Window>
